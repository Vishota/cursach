            name="mailPassthru" visibility="private" ><ownedParameter xmi:id="63a4c6d2135253.56602713" name="return" direction="return"><type xmi:idref="63a4c6d209e377.76986812"/></ownedParameter><ownedParameter xmi:id="63a4c6d2135284.66146116" name="$to" direction="in"><type xmi:idref="63a4c6d209e2b6.20155476"/></ownedParameter><ownedParameter xmi:id="63a4c6d21352d7.78558743" name="$subject" direction="in"><type xmi:idref="63a4c6d209e2b6.20155476"/></ownedParameter><ownedParameter xmi:id="63a4c6d2135311.58825027" name="$body" direction="in"><type xmi:idref="63a4c6d209e2b6.20155476"/></ownedParameter><ownedParameter xmi:id="63a4c6d2135355.64099792" name="$header" direction="in"><type xmi:idref="63a4c6d209e2b6.20155476"/></ownedParameter><ownedParameter xmi:id="63a4c6d21353a6.14323617" name="$params" direction="in"></ownedParameter><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21dcc21.61966904" annotatedElement="63a4c6d21350c2.90517583"><body>Call mail() in a safe_mode-aware fashion.
Also, unless sendmail_path points to sendmail (or something that claims to be sendmail), don't pass params (not a perfect fix, but it will do).</body></ownedComment></ownedOperation><ownedOperation xmi:id="63a4c6d2135bc4.73910227" 
