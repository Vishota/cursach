ml:Property" name="CONTENT_TYPE_MULTIPART_ALTERNATIVE" xmi:id="63a4c6d2124676.52665886" visibility="public"  isStatic="true" isReadOnly="true" ><type xmi:idref="63a4c6d209e2b6.20155476"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21da792.98885253" value="&#039;multipart/alternative&#039;" /></ownedAttribute><ownedAttribute xmi:type="uml:Property" name="CONTENT_TYPE_MULTIPART_MIXED" xmi:id="63a4c6d2124717.29391573" visibility="public"  isStatic="true" isReadOnly="true" ><type xmi:idref="63a4c6d209e2b6.20155476"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21da7c5.92393712" value="&#039;multipart/mixed&#039;" /></ownedAttribute><ownedAttribute xmi:type="uml:Property" name="CONTENT_TYPE_MULTIPART_RELATED" xmi:id="63a4c6d21247b9.83102239" visibility="public"  isStatic="true" isReadOnly="true" ><type xmi:idref="63a4c6d209e2b6.20155476"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21da7f0.40695711" value="&#039;multipart/related&#039;" /></ownedAttribute><ownedAttribute xmi:type="uml:Property" name="ENCODING_7BIT" xmi:id="63a4c6d21248a2.30686100" visibility="public"  isStatic="true" isReadOnly="true" ><type xmi:idref="63a4c6d209e2b6.20155476"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21da828.29166194" value="&#039;7bit&#039;" /></ownedAttribute><ownedAttribute xmi:type="uml:Property" name="ENCODING_8BIT" xmi:id="63a4c6d2124943.48634392" visibility="public"  isStatic="true" isReadOnly="true" ><type xmi:idref="63a4c6d209e2b6.20155476"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21da869.05707942" value="&#039;8bit&#039;" /></ownedAttribute><ownedAttribute xmi:type="uml:Property" name="ENCODING_BASE64" xmi:id="63a4c6d21249e3.77466904" visibility="public"  isStatic="true" isReadOnly="true" ><type xmi:idref="63a4c6d209e2b6.20155476"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21da893.54960896" value="&#039;base64&#039;" /></ownedAttribute><ownedAttribute xmi:type="uml:Property" name="ENCODING_BINARY" xmi:id="63a4c6d2124a81.92425105" visibility="public"  isStatic="true" isReadOnly="true" ><type xmi:idref="63a4c6d209e2b6.20155476"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21da8c9.13538848" value="&#039;binary&#039;" /></ownedAttribute><ownedAttribute xmi:type="uml:Property" name="ENCODING_QUOTED_PRINTABLE" xmi:id="63a4c6d2124b28.23398676" visibility="public"  isStatic="true" isReadOnly="true" ><type xmi:idref="63a4c6d209e2b6.20155476"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21da8f3.93132284" value="&#039;quoted-printable&#039;" /></ownedAttribute><ownedAttribute xmi:type="uml:Property" name="ENCRYPTION_STARTTLS" xmi:id="63a4c6d2124bd6.01327609" visibility="public"  isStatic="true" isReadOnly="true" ><type xmi:idref="63a4c6d209e2b6.20155476"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21da936.90450019" value="&#039;tls&#039;" /></ownedAttribute><ownedAttribute xmi:type="uml:Property" name="ENCRYPTION_SMTPS" xmi:id="63a4c6d2124c71.95294425" visibility="public"  isStatic="true" isReadOnly="true" ><type xmi:idref="63a4c6d209e2b6.20155476"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21da960.68047265" value="&#039;ssl&#039;" /></ownedAttribute><ownedAttribute xmi:type="uml:Property" name="ICAL_METHOD_REQUEST" xmi:id="63a4c6d2124d12.54988716" visibility="public"  isStatic="true" isReadOnly="true" ><type xmi:idref="63a4c6d209e2b6.20155476"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21da993.17688451" value="&#039;REQUEST&#039;" /></ownedAttribute><ownedAttribute xmi:type="uml:Property" name="ICAL_METHOD_PUBLISH" xmi:id="63a4c6d2124dc7.09554829" visibility="public"  isStatic="true" isReadOnly="true" ><type xmi:idref="63a4c6d209e2b6.20155476"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21da9c2.16391226" value="&#039;PUBLISH&#039;" /></ownedAttribute><ownedAttribute xmi:type="uml:Property" name="ICAL_METHOD_REPLY" xmi:id="63a4c6d2124e64.24265413" visibility="public"  isStatic="true" isReadOnly="true" ><type xmi:idref="63a4c6d209e2b6.20155476"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21da9f4.91916676" value="&#039;REPLY&#039;" /></ownedAttribute><ownedAttribute xmi:type="uml:Property" name="ICAL_METHOD_ADD" xmi:id="63a4c6d2124f04.06879355" visibility="public"  isStatic="true" isReadOnly="true" ><type xmi:idref="63a4c6d209e2b6.20155476"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21daa38.90897836" value="&#039;ADD&#039;" /></ownedAttribute><ownedAttribute xmi:type="uml:Property" name="ICAL_METHOD_CANCEL" xmi:id="63a4c6d2124fa1.22706083" visibility="public"  isStatic="true" isReadOnly="true" ><type xmi:idref="63a4c6d209e2b6.20155476"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21daa60.61954883" value="&#039;CANCEL&#039;" /></ownedAttribute><ownedAttribute xmi:type="uml:Property" name="ICAL_METHOD_REFRESH" xmi:id="63a4c6d2125042.12057681" visibility="public"  isStatic="true" isReadOnly="true" ><type xmi:idref="63a4c6d209e2b6.20155476"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21daa92.19092090" value="&#039;REFRESH&#039;" /></ownedAttribute><ownedAttribute xmi:type="uml:Property" name="ICAL_METHOD_COUNTER" xmi:id="63a4c6d21250f0.01361869" visibility="public"  isStatic="true" isReadOnly="true" ><type xmi:idref="63a4c6d209e2b6.20155476"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21daac9.52527879" value="&#039;COUNTER&#039;" /></ownedAttribute><ownedAttribute xmi:type="uml:Property" name="ICAL_METHOD_DECLINECOUNTER" xmi:id="63a4c6d2125194.83346385" visibility="public"  isStatic="true" isReadOnly="true" ><type xmi:idref="63a4c6d209e2b6.20155476"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21daaf2.69682099" value="&#039;DECLINECOUNTER&#039;" /></ownedAttribute><ownedAttribute xmi:type="uml:Property" name="$Priority" xmi:id="63a4c6d21253c1.93022545" visibility="public" ><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21dab45.90145687" annotatedElement="63a4c6d21253c1.93022545"><body>Email priority.
Options: null (default), 1 = High, 3 = Normal, 5 = low.
When null, the header is not set at all.</body></ownedComment></ownedAttribute><ownedAttribute xmi:type="uml:Property" name="$CharSet" xmi:id="63a4c6d21255e3.25359073" visibility="public" ><type xmi:idref="63a4c6d209e2b6.20155476"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21dab82.61986763" value="selfCHARSET_ISO88591" /><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21daba9.16373385" annotatedElement="63a4c6d21255e3.25359073"><body>The character set of the message.</body></ownedComment></ownedAttribute><ownedAttribute xmi:type="uml:Property" name="$ContentType" xmi:id="63a4c6d21257e8.05278407" visibility="public" ><type xmi:idref="63a4c6d209e2b6.20155476"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21dabd9.30596180" value="selfCONTENT_TYPE_PLAINTEXT" /><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21dabf3.05179829" annotatedElement="63a4c6d21257e8.05278407"><body>The MIME Content-type of the message.</body></ownedComment></ownedAttribute><ownedAttribute xmi:type="uml:Property" name="$Encoding" xmi:id="63a4c6d2125a53.92901764" visibility="public" ><type xmi:idref="63a4c6d209e2b6.20155476"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21dac25.09451873" value="selfENCODING_8BIT" /><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21dac43.36417824" annotatedElement="63a4c6d2125a53.92901764"><body>The message encoding.
Options: &quot;8bit&quot;, &quot;7bit&quot;, &quot;binary&quot;, &quot;base64&quot;, and &quot;quoted-printable&quot;.</body></ownedComment></ownedAttribute><ownedAttribute xmi:type="uml:Property" name="$ErrorInfo" xmi:id="63a4c6d2125c54.87521743" visibility="public" ><type xmi:idref="63a4c6d209e2b6.20155476"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21dac80.18825890" value="&#039;&#039;" /><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21daca2.66565659" annotatedElement="63a4c6d2125c54.87521743"><body>Holds the most recent mailer error message.</body></ownedComment></ownedAttribute><ownedAttribute xmi:type="uml:Property" name="$From" xmi:id="63a4c6d2125e40.19401566" visibility="public" ><type xmi:idref="63a4c6d209e2b6.20155476"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21dacd4.88926540" value="&#039;&#039;" /><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21dacf0.57762600" annotatedElement="63a4c6d2125e40.19401566"><body>The From email address for the message.</body></ownedComment></ownedAttribute><ownedAttribute xmi:type="uml:Property" name="$FromName" xmi:id="63a4c6d2126006.60132499" visibility="public" ><type xmi:idref="63a4c6d209e2b6.20155476"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21dad22.66204305" value="&#039;&#039;" /><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21dad52.65872903" annotatedElement="63a4c6d2126006.60132499"><body>The From name of the message.</body></ownedComment></ownedAttribute><ownedAttribute xmi:type="uml:Property" name="$Sender" xmi:id="63a4c6d21263d3.17975871" visibility="public" ><type xmi:idref="63a4c6d209e2b6.20155476"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21dad79.74883155" value="&#039;&#039;" /><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21dad99.57569180" annotatedElement="63a4c6d21263d3.17975871"><body>The envelope sender of the message.
This will usually be turned into a Return-Path header by the receiver, and is the address that bounces will be sent to.
If not empty, will be passed via `-f` to sendmail or as the 'MAIL FROM' value over SMTP.</body></ownedComment></ownedAttribute><ownedAttribute xmi:type="uml:Property" name="$Subject" xmi:id="63a4c6d21265b3.50853867" visibility="public" ><type xmi:idref="63a4c6d209e2b6.20155476"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21dade5.17523626" value="&#039;&#039;" /><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21dae04.12279215" annotatedElement="63a4c6d21265b3.50853867"><body>The Subject of the message.</body></ownedComment></ownedAttribute><ownedAttribute xmi:type="uml:Property" name="$Body" xmi:id="63a4c6d21267e4.27287254" visibility="public" ><type xmi:idref="63a4c6d209e2b6.20155476"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21dae30.17985837" value="&#039;&#039;" /><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21dae53.17422767" annotatedElement="63a4c6d21267e4.27287254"><body>An HTML or plain text message body.
If HTML then call isHTML(true).</body></ownedComment></ownedAttribute><ownedAttribute xmi:type="uml:Property" name="$AltBody" xmi:id="63a4c6d2126b20.99406067" visibility="public" ><type xmi:idref="63a4c6d209e2b6.20155476"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21dae85.50695612" value="&#039;&#039;" /><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21daea6.75228719" annotatedElement="63a4c6d2126b20.99406067"><body>The plain-text message body.
This body can be read by mail clients that do not have HTML email capability such as mutt &amp; Eudora.
Clients that can read HTML will view the normal Body.</body></ownedComment></ownedAttribute><ownedAttribute xmi:type="uml:Property" name="$Ical" xmi:id="63a4c6d2126f95.36713555" visibility="public" ><type xmi:idref="63a4c6d209e2b6.20155476"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21daee7.46752986" value="&#039;&#039;" /><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21daf18.43755338" annotatedElement="63a4c6d2126f95.36713555"><body>An iCal message part body.
Only supported in simple alt or alt_inline message types To generate iCal event structures, use classes like EasyPeasyICS or iCalcreator.</body></ownedComment></ownedAttribute><ownedAttribute xmi:type="uml:Property" name="$IcalMethods" xmi:id="63a4c6d21272c7.83052786" visibility="protected"  isStatic="true"><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21daf51.57973212" value="selfICAL_METHOD_REQUEST" /><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21daf70.60375008" annotatedElement="63a4c6d21272c7.83052786"><body>Value-array of &quot;method&quot; in Contenttype header &quot;text/calendar&quot;</body></ownedComment></ownedAttribute><ownedAttribute xmi:type="uml:Property" name="self" xmi:id="63a4c6d21273c6.39184302" visibility="public" ><type xmi:idref="63a4c6d209a1d2.76864075"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21dafa5.36198433" value="ICAL_METHOD_PUBLISH" /></ownedAttribute><ownedAttribute xmi:type="uml:Property" name="self" xmi:id="63a4c6d2127451.17533865" visibility="public" ><type xmi:idref="63a4c6d209a1d2.76864075"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21dafd5.75981227" value="ICAL_METHOD_REPLY" /></ownedAttribute><ownedAttribute xmi:type="uml:Property" name="self" xmi:id="63a4c6d21274d4.38724303" visibility="public" ><type xmi:idref="63a4c6d209a1d2.76864075"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21db008.81564194" value="ICAL_METHOD_ADD" /></ownedAttribute><ownedAttribute xmi:type="uml:Property" name="self" xmi:id="63a4c6d2127555.56754262" visibility="public" ><type xmi:idref="63a4c6d209a1d2.76864075"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21db036.11016679" value="ICAL_METHOD_CANCEL" /></ownedAttribute><ownedAttribute xmi:type="uml:Property" name="self" xmi:id="63a4c6d21275d8.38100836" visibility="public" ><type xmi:idref="63a4c6d209a1d2.76864075"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21db060.78637868" value="ICAL_METHOD_REFRESH" /></ownedAttribute><ownedAttribute xmi:type="uml:Property" name="self" xmi:id="63a4c6d2127661.13327322" visibility="public" ><type xmi:idref="63a4c6d209a1d2.76864075"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21db091.74520640" value="ICAL_METHOD_COUNTER" /></ownedAttribute><ownedAttribute xmi:type="uml:Property" name="self" xmi:id="63a4c6d21276e0.80228402" visibility="public" ><type xmi:idref="63a4c6d209a1d2.76864075"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21db0c2.94202600" value="ICAL_METHOD_DECLINECOUNTER" /></ownedAttribute><ownedAttribute xmi:type="uml:Property" name="$MIMEBody" xmi:id="63a4c6d2127890.35268272" visibility="protected" ><type xmi:idref="63a4c6d209e2b6.20155476"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21db108.64484054" value="&#039;&#039;" /><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21db125.22722661" annotatedElement="63a4c6d2127890.35268272"><body>The complete compiled MIME message body.</body></ownedComment></ownedAttribute><ownedAttribute xmi:type="uml:Property" name="$MIMEHeader" xmi:id="63a4c6d2127a77.07147356" visibility="protected" ><type xmi:idref="63a4c6d209e2b6.20155476"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21db158.65266574" value="&#039;&#039;" /><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21db171.96037858" annotatedElement="63a4c6d2127a77.07147356"><body>The complete compiled MIME message headers.</body></ownedComment></ownedAttribute><ownedAttribute xmi:type="uml:Property" name="$mailHeader" xmi:id="63a4c6d2127c79.02820815" visibility="protected" ><type xmi:idref="63a4c6d209e2b6.20155476"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21db199.89496078" value="&#039;&#039;" /><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21db1c9.60273818" annotatedElement="63a4c6d2127c79.02820815"><body>Extra headers that createHeader() doesn't fold in.</body></ownedComment></ownedAttribute><ownedAttribute xmi:type="uml:Property" name="$WordWrap" xmi:id="63a4c6d2127f91.08417337" visibility="public" ><type xmi:idref="63a4c6d209e2f2.35908695"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21db1f6.94570175" value="0" /><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21db216.48373537" annotatedElement="63a4c6d2127f91.08417337"><body>Word-wrap the message body to this number of chars.
Set to 0 to not wrap. A useful value here is 78, for RFC2822 section 2.1.1 compliance.</body></ownedComment></ownedAttribute><ownedAttribute xmi:type="uml:Property" name="$Mailer" xmi:id="63a4c6d2128269.33850579" visibility="public" ><type xmi:idref="63a4c6d209e2b6.20155476"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21db257.18908959" value="&#039;mail&#039;" /><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21db272.41203131" annotatedElement="63a4c6d2128269.33850579"><body>Which method to use to send mail.
Options: &quot;mail&quot;, &quot;sendmail&quot;, or &quot;smtp&quot;.</body></ownedComment></ownedAttribute><ownedAttribute xmi:type="uml:Property" name="$Sendmail" xmi:id="63a4c6d2128439.87516588" visibility="public" ><type xmi:idref="63a4c6d209e2b6.20155476"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21db2a2.76219643" value="&#039;/usr/sbin/sendmail&#039;" /><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21db2d9.81201113" annotatedElement="63a4c6d2128439.87516588"><body>The path to the sendmail program.</body></ownedComment></ownedAttribute><ownedAttribute xmi:type="uml:Property" name="$UseSendmailOptions" xmi:id="63a4c6d21286a6.58339758" visibility="public" ><type xmi:idref="63a4c6d209e377.76986812"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21db2f3.67252040" value="true" /><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21db325.43784914" annotatedElement="63a4c6d21286a6.58339758"><body>Whether mail() uses a fully sendmail-compatible MTA.
One which supports sendmail's &quot;-oi -f&quot; options.</body></ownedComment></ownedAttribute><ownedAttribute xmi:type="uml:Property" name="$ConfirmReadingTo" xmi:id="63a4c6d2128900.98308490" visibility="public" ><type xmi:idref="63a4c6d209e2b6.20155476"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21db356.07775664" value="&#039;&#039;" /><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21db377.48285749" annotatedElement="63a4c6d2128900.98308490"><body>The email address that a reading confirmation should be sent to, also known as read receipt.</body></ownedComment></ownedAttribute><ownedAttribute xmi:type="uml:Property" name="$Hostname" xmi:id="63a4c6d2128ce2.85425203" visibility="public" ><type xmi:idref="63a4c6d209e2b6.20155476"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21db3a6.50212242" value="&#039;&#039;" /><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21db3d1.63728612" annotatedElement="63a4c6d2128ce2.85425203"><body>The hostname to use in the Message-ID header and as default HELO string.
If empty, PHPMailer attempts to find one with, in order, $_SERVER['SERVER_NAME'], gethostname(), php_uname('n'), or the value 'localhost.localdomain'.</body></ownedComment></ownedAttribute><ownedAttribute xmi:type="uml:Property" name="$MessageID" xmi:id="63a4c6d2129141.55522789" visibility="public" ><type xmi:idref="63a4c6d209e2b6.20155476"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21db418.84660768" value="&#039;&#039;" /><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21db440.15637931" annotatedElement="63a4c6d2129141.55522789"><body>An ID to be used in the Message-ID header.
If empty, a unique id will be generated.
You can set your own, but it must be in the format &quot;&lt;id@domain&gt;&quot;, as defined in RFC5322 section 3.6.4 or it will be ignored.</body></ownedComment></ownedAttribute><ownedAttribute xmi:type="uml:Property" name="$MessageDate" xmi:id="63a4c6d21293e4.29715795" visibility="public" ><type xmi:idref="63a4c6d209e2b6.20155476"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21db488.97180008" value="&#039;&#039;" /><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21db4a9.24309766" annotatedElement="63a4c6d21293e4.29715795"><body>The message Date to be used in the Date header.
If empty, the current date will be added.</body></ownedComment></ownedAttribute><ownedAttribute xmi:type="uml:Property" name="$Host" xmi:id="63a4c6d21298f2.35978655" visibility="public" ><type xmi:idref="63a4c6d209e2b6.20155476"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21db4d7.72058036" value="&#039;localhost&#039;" /><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21db509.21717038" annotatedElement="63a4c6d21298f2.35978655"><body>SMTP hosts.
Either a single hostname or multiple semicolon-delimited hostnames.
You can also specify a different port for each host by using this format: [hostname:port] (e.g. &quot;smtp1.example.com:25;smtp2.example.com&quot;).
You can also specify encryption type, for example:
(e.g. &quot;tls://smtp1.example.com:587;ssl://smtp2.example.com:465&quot;).
Hosts will be tried in order.</body></ownedComment></ownedAttribute><ownedAttribute xmi:type="uml:Property" name="$Port" xmi:id="63a4c6d2129b06.64943932" visibility="public" ><type xmi:idref="63a4c6d209e2f2.35908695"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21db564.48542159" value="25" /><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21db586.92213457" annotatedElement="63a4c6d2129b06.64943932"><body>The default SMTP server port.</body></ownedComment></ownedAttribute><ownedAttribute xmi:type="uml:Property" name="$Helo" xmi:id="63a4c6d2129e80.07554359" visibility="public" ><type xmi:idref="63a4c6d209e2b6.20155476"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21db5b3.95091442" value="&#039;&#039;" /><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21db5d9.13993990" annotatedElement="63a4c6d2129e80.07554359"><body>The SMTP HELO/EHLO name used for the SMTP connection.
Default is $Hostname. If $Hostname is empty, PHPMailer attempts to find one with the same method described above for $Hostname.</body></ownedComment></ownedAttribute><ownedAttribute xmi:type="uml:Property" name="$SMTPSecure" xmi:id="63a4c6d212a164.45878822" visibility="public" ><type xmi:idref="63a4c6d209e2b6.20155476"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21db612.90687449" value="&#039;&#039;" /><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21db632.17432475" annotatedElement="63a4c6d212a164.45878822"><body>What kind of encryption to use on the SMTP connection.
Options: '', static::ENCRYPTION_STARTTLS, or static::ENCRYPTION_SMTPS.</body></ownedComment></ownedAttribute><ownedAttribute xmi:type="uml:Property" name="$SMTPAutoTLS" xmi:id="63a4c6d212a4c6.66420620" visibility="public" ><type xmi:idref="63a4c6d209e377.76986812"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21db677.83830769" value="true" /><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21db693.72188789" annotatedElement="63a4c6d212a4c6.66420620"><body>Whether to enable TLS encryption automatically if a server supports it, even if `SMTPSecure` is not set to 'tls'.
Be aware that in PHP &gt;= 5.6 this requires that the server's certificates are valid.</body></ownedComment></ownedAttribute><ownedAttribute xmi:type="uml:Property" name="$SMTPAuth" xmi:id="63a4c6d212a7b8.17536400" visibility="public" ><type xmi:idref="63a4c6d209e377.76986812"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21db6d1.12229504" value="false" /><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21db6f0.91889326" annotatedElement="63a4c6d212a7b8.17536400"><body>Whether to use SMTP authentication.
Uses the Username and Password properties.</body></ownedComment></ownedAttribute><ownedAttribute xmi:type="uml:Property" name="$SMTPOptions" xmi:id="63a4c6d212aa22.07365675" visibility="public" ><type xmi:idref="63a4c6d209e232.56111258"/><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21db741.14947019" annotatedElement="63a4c6d212aa22.07365675"><body>Options array passed to stream_context_create when connecting via SMTP.</body></ownedComment></ownedAttribute><ownedAttribute xmi:type="uml:Property" name="$Username" xmi:id="63a4c6d212abe2.75604348" visibility="public" ><type xmi:idref="63a4c6d209e2b6.20155476"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21db778.43036805" value="&#039;&#039;" /><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21db799.69859116" annotatedElement="63a4c6d212abe2.75604348"><body>SMTP username.</body></ownedComment></ownedAttribute><ownedAttribute xmi:type="uml:Property" name="$Password" xmi:id="63a4c6d212adc3.62037393" visibility="public" ><type xmi:idref="63a4c6d209e2b6.20155476"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21db7c7.42599206" value="&#039;&#039;" /><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21db7e6.09967125" annotatedElement="63a4c6d212adc3.62037393"><body>SMTP password.</body></ownedComment></ownedAttribute><ownedAttribute xmi:type="uml:Property" name="$AuthType" xmi:id="63a4c6d212b0b7.71381513" visibility="public" ><type xmi:idref="63a4c6d209e2b6.20155476"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21db812.47412059" value="&#039;&#039;" /><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21db837.39113676" annotatedElement="63a4c6d212b0b7.71381513"><body>SMTP authentication type. Options are CRAM-MD5, LOGIN, PLAIN, XOAUTH2.
If not specified, the first one from that list that the server supports will be selected.</body></ownedComment></ownedAttribute><ownedAttribute xmi:type="uml:Property" name="$oauth" xmi:id="63a4c6d212b2e3.18833137" visibility="protected" ><type xmi:idref="63a4c6d2114089.99950322"/><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21db896.79937265" annotatedElement="63a4c6d212b2e3.18833137"><body>An implementation of the PHPMailer OAuthTokenProvider interface.</body></ownedComment></ownedAttribute><ownedAttribute xmi:type="uml:Property" name="$Timeout" xmi:id="63a4c6d212b589.27483216" visibility="public" ><type xmi:idref="63a4c6d209e2f2.35908695"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21db8b5.91935400" value="300" /><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21db8e9.95853549" annotatedElement="63a4c6d212b589.27483216"><body>The SMTP server timeout in seconds.
Default of 5 minutes (300sec) is from RFC2821 section 4.5.3.2.</body></ownedComment></ownedAttribute><ownedAttribute xmi:type="uml:Property" name="$dsn" xmi:id="63a4c6d212bc09.05477336" visibility="public" ><type xmi:idref="63a4c6d209e2b6.20155476"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21db917.39737258" value="&#039;&#039;" /><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21db944.06733190" annotatedElement="63a4c6d212bc09.05477336"><body>Comma separated list of DSN notifications 'NEVER' under no circumstances a DSN must be returned to the sender.
If you use NEVER all other notifications will be ignored.
'SUCCESS' will notify you when your mail has arrived at its destination.
'FAILURE' will arrive if an error occurred during delivery.
'DELAY'   will notify you if there is an unusual delay in delivery, but the actual delivery's outcome (success or failure) is not yet decided.</body></ownedComment></ownedAttribute><ownedAttribute xmi:type="uml:Property" name="$SMTPDebug" xmi:id="63a4c6d212c294.59199471" visibility="public" ><type xmi:idref="63a4c6d209e2f2.35908695"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21db9a6.51787480" value="0" /><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21db9c4.40816019" annotatedElement="63a4c6d212c294.59199471"><body>SMTP class debug output mode.
Debug output level.
Options:</body></ownedComment></ownedAttribute><ownedAttribute xmi:type="uml:Property" name="$Debugoutput" xmi:id="63a4c6d212cd18.17422701" visibility="public" ><type xmi:idref="63a4c6d209e2b6.20155476"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21db9f7.93814508" value="&#039;echo&#039;" /><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21dba29.65547006" annotatedElement="63a4c6d212cd18.17422701"><body>How to handle debug output.
Options:
* `echo` Output plain-text as-is, appropriate for CLI * `html` Output escaped, line breaks converted to `&lt;br&gt;`, appropriate for browser output * `error_log` Output to error log as configured in php.ini By default PHPMailer will use `echo` if run from a `cli` or `cli-server` SAPI, `html` otherwise.
Alternatively, you can provide a callable expecting two params: a message string and the debug level:

```php $mail-&gt;Debugoutput = function($str, $level) {echo &quot;debug level $level; message: $str&quot;;}; ``` 
Alternatively, you can pass in an instance of a PSR-3 compatible logger, though only `debug` level output is used:

```php $mail-&gt;Debugoutput = new myPsr3Logger; ```</body></ownedComment></ownedAttribute><ownedAttribute xmi:type="uml:Property" name="$SMTPKeepAlive" xmi:id="63a4c6d212d299.13799494" visibility="public" ><type xmi:idref="63a4c6d209e377.76986812"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21dbaa1.66864529" value="false" /><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21dbad0.61251550" annotatedElement="63a4c6d212d299.13799494"><body>Whether to keep the SMTP connection open after each message.
If this is set to true then the connection will remain open after a send, and closing the connection will require_once an explicit call to smtpClose().
It's a good idea to use this if you are sending multiple messages as it reduces overhead.
See the mailing list example for how to use it.</body></ownedComment></ownedAttribute><ownedAttribute xmi:type="uml:Property" name="$SingleTo" xmi:id="63a4c6d212d655.99435929" visibility="public" ><type xmi:idref="63a4c6d209e377.76986812"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21dbb23.30933140" value="false" /><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21dbb53.07896207" annotatedElement="63a4c6d212d655.99435929"><body>Whether to split multiple to addresses into multiple messages or send them all in one message.
Only supported in `mail` and `sendmail` transports, not in SMTP.</body></ownedComment></ownedAttribute><ownedAttribute xmi:type="uml:Property" name="$SingleToArray" xmi:id="63a4c6d212d880.51578773" visibility="protected" ><type xmi:idref="63a4c6d209e232.56111258"/><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21dbba7.50889280" annotatedElement="63a4c6d212d880.51578773"><body>Storage for addresses when SingleTo is enabled.</body></ownedComment></ownedAttribute><ownedAttribute xmi:type="uml:Property" name="$do_verp" xmi:id="63a4c6d212dc14.12549425" visibility="public" ><type xmi:idref="63a4c6d209e377.76986812"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21dbbd8.98980043" value="false" /><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21dbbf9.80210504" annotatedElement="63a4c6d212dc14.12549425"><body>Whether to generate VERP addresses on send.
Only applicable when sending via SMTP.</body></ownedComment></ownedAttribute><ownedAttribute xmi:type="uml:Property" name="$AllowEmpty" xmi:id="63a4c6d212de55.24706821" visibility="public" ><type xmi:idref="63a4c6d209e377.76986812"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21dbc25.25027500" value="false" /><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21dbc52.51016021" annotatedElement="63a4c6d212de55.24706821"><body>Whether to allow sending messages with an empty body.</body></ownedComment></ownedAttribute><ownedAttribute xmi:type="uml:Property" name="$DKIM_selector" xmi:id="63a4c6d212e003.31644662" visibility="public" ><type xmi:idref="63a4c6d209e2b6.20155476"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21dbc73.09750986" value="&#039;&#039;" /><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21dbc90.35573970" annotatedElement="63a4c6d212e003.31644662"><body>DKIM selector.</body></ownedComment></ownedAttribute><ownedAttribute xmi:type="uml:Property" name="$DKIM_identity" xmi:id="63a4c6d212e225.39671277" visibility="public" ><type xmi:idref="63a4c6d209e2b6.20155476"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21dbcd4.63798763" value="&#039;&#039;" /><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21dbd06.20172931" annotatedElement="63a4c6d212e225.39671277"><body>DKIM Identity.
Usually the email address used as the source of the email.</body></ownedComment></ownedAttribute><ownedAttribute xmi:type="uml:Property" name="$DKIM_passphrase" xmi:id="63a4c6d212e421.45983723" visibility="public" ><type xmi:idref="63a4c6d209e2b6.20155476"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21dbd41.18811981" value="&#039;&#039;" /><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21dbd89.74593183" annotatedElement="63a4c6d212e421.45983723"><body>DKIM passphrase.
Used if your key is encrypted.</body></ownedComment></ownedAttribute><ownedAttribute xmi:type="uml:Property" name="$DKIM_domain" xmi:id="63a4c6d212e634.97649304" visibility="public" ><type xmi:idref="63a4c6d209e2b6.20155476"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21dbdb9.31561630" value="&#039;&#039;" /><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21dbde0.03979172" annotatedElement="63a4c6d212e634.97649304"><body>DKIM signing domain name.</body></ownedComment></ownedAttribute><ownedAttribute xmi:type="uml:Property" name="$DKIM_copyHeaderFields" xmi:id="63a4c6d212e842.17895422" visibility="public" ><type xmi:idref="63a4c6d209e377.76986812"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21dbe03.09733388" value="true" /><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21dbe39.39189184" annotatedElement="63a4c6d212e842.17895422"><body>DKIM Copy header field values for diagnostic use.</body></ownedComment></ownedAttribute><ownedAttribute xmi:type="uml:Property" name="$DKIM_extraHeaders" xmi:id="63a4c6d212ea88.44826706" visibility="public" ><type xmi:idref="63a4c6d209e232.56111258"/><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21dbe73.62731486" annotatedElement="63a4c6d212ea88.44826706"><body>DKIM Extra signing headers.</body></ownedComment></ownedAttribute><ownedAttribute xmi:type="uml:Property" name="$DKIM_private" xmi:id="63a4c6d212ec75.43629001" visibility="public" ><type xmi:idref="63a4c6d209e2b6.20155476"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21dbea1.34009133" value="&#039;&#039;" /><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21dbec4.81982919" annotatedElement="63a4c6d212ec75.43629001"><body>DKIM private key file path.</body></ownedComment></ownedAttribute><ownedAttribute xmi:type="uml:Property" name="$DKIM_private_string" xmi:id="63a4c6d212eea3.70951832" visibility="public" ><type xmi:idref="63a4c6d209e2b6.20155476"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21dbef6.08350168" value="&#039;&#039;" /><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21dbf14.87994121" annotatedElement="63a4c6d212eea3.70951832"><body>DKIM private key string.

If set, takes precedence over `$DKIM_private`.</body></ownedComment></ownedAttribute><ownedAttribute xmi:type="uml:Property" name="$action_function" xmi:id="63a4c6d212f6c0.08890304" visibility="public" ><type xmi:idref="63a4c6d209e2b6.20155476"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21dbf48.42134411" value="&#039;&#039;" /><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21dbf63.62141447" annotatedElement="63a4c6d212f6c0.08890304"><body>Callback Action function name.

The function that handles the result of the send email action.
It is called out by send() for each email sent.

Value can be any php callable: http://www.php.net/is_callable 
Parameters:
bool $result        result of the send action array   $to            email addresses of the recipients array   $cc            cc email addresses array   $bcc           bcc email addresses string  $subject       the subject string  $body          the email body string  $from          email address of sender string  $extra         extra information of possible use &quot;smtp_transaction_id' =&gt; last smtp transaction id</body></ownedComment></ownedAttribute><ownedAttribute xmi:type="uml:Property" name="$XMailer" xmi:id="63a4c6d212fa19.14870031" visibility="public" ><type xmi:idref="63a4c6d209e2b6.20155476"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21dbff6.18333879" value="&#039;&#039;" /><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21dc016.26980151" annotatedElement="63a4c6d212fa19.14870031"><body>What to put in the X-Mailer header.
Options: An empty string for PHPMailer default, whitespace/null for none, or a string to use.</body></ownedComment></ownedAttribute><ownedAttribute xmi:type="uml:Property" name="$validator" xmi:id="63a4c6d212ffe8.10574342" visibility="public"  isStatic="true"><type xmi:idref="63a4c6d209e2b6.20155476"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21dc050.35231333" value="&#039;php&#039;" /><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21dc072.35772879" annotatedElement="63a4c6d212ffe8.10574342"><body>Which validator to use by default when validating email addresses.
May be a callable to inject your own validator, but there are several built-in validators.
The default validator uses PHP's FILTER_VALIDATE_EMAIL filter_var option.</body></ownedComment></ownedAttribute><ownedAttribute xmi:type="uml:Property" name="$smtp" xmi:id="63a4c6d21301e8.86632814" visibility="protected" ><type xmi:idref="63a4c6d2186547.70864334"/><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21dc0d9.83310091" annotatedElement="63a4c6d21301e8.86632814"><body>An instance of the SMTP sender class.</body></ownedComment></ownedAttribute><ownedAttribute xmi:type="uml:Property" name="$to" xmi:id="63a4c6d21303c0.89101060" visibility="protected" ><type xmi:idref="63a4c6d209e232.56111258"/><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21dc129.20189299" annotatedElement="63a4c6d21303c0.89101060"><body>The array of 'to' names and addresses.</body></ownedComment></ownedAttribute><ownedAttribute xmi:type="uml:Property" name="$cc" xmi:id="63a4c6d21305a8.76255382" visibility="protected" ><type xmi:idref="63a4c6d209e232.56111258"/><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21dc168.06885321" annotatedElement="63a4c6d21305a8.76255382"><body>The array of 'cc' names and addresses.</body></ownedComment></ownedAttribute><ownedAttribute xmi:type="uml:Property" name="$bcc" xmi:id="63a4c6d2130785.45214507" visibility="protected" ><type xmi:idref="63a4c6d209e232.56111258"/><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21dc1b4.16427374" annotatedElement="63a4c6d2130785.45214507"><body>The array of 'bcc' names and addresses.</body></ownedComment></ownedAttribute><ownedAttribute xmi:type="uml:Property" name="$ReplyTo" xmi:id="63a4c6d2130961.93211092" visibility="protected" ><type xmi:idref="63a4c6d209e232.56111258"/><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21dc1f6.91580285" annotatedElement="63a4c6d2130961.93211092"><body>The array of reply-to names and addresses.</body></ownedComment></ownedAttribute><ownedAttribute xmi:type="uml:Property" name="$all_recipients" xmi:id="63a4c6d2130c56.45023677" visibility="protected" ><type xmi:idref="63a4c6d209e232.56111258"/><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21dc246.28455427" annotatedElement="63a4c6d2130c56.45023677"><body>An array of all kinds of addresses.
Includes all of $to, $cc, $bcc.</body></ownedComment></ownedAttribute><ownedAttribute xmi:type="uml:Property" name="$RecipientsQueue" xmi:id="63a4c6d2131152.43259359" visibility="protected" ><type xmi:idref="63a4c6d209e232.56111258"/><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21dc291.63483429" annotatedElement="63a4c6d2131152.43259359"><body>An array of names and addresses queued for validation.
In send(), valid and non duplicate entries are moved to $all_recipients and one of $to, $cc, or $bcc.
This array is used only for addresses with IDN.</body></ownedComment></ownedAttribute><ownedAttribute xmi:type="uml:Property" name="$ReplyToQueue" xmi:id="63a4c6d2131583.04562181" visibility="protected" ><type xmi:idref="63a4c6d209e232.56111258"/><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21dc2f8.32700618" annotatedElement="63a4c6d2131583.04562181"><body>An array of reply-to names and addresses queued for validation.
In send(), valid and non duplicate entries are moved to $ReplyTo.
This array is used only for addresses with IDN.</body></ownedComment></ownedAttribute><ownedAttribute xmi:type="uml:Property" name="$attachment" xmi:id="63a4c6d2131789.07956139" visibility="protected" ><type xmi:idref="63a4c6d209e232.56111258"/><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21dc351.00042898" annotatedElement="63a4c6d2131789.07956139"><body>The array of attachments.</body></ownedComment></ownedAttribute><ownedAttribute xmi:type="uml:Property" name="$CustomHeader" xmi:id="63a4c6d2131945.53688939" visibility="protected" ><type xmi:idref="63a4c6d209e232.56111258"/><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21dc393.80557706" annotatedElement="63a4c6d2131945.53688939"><body>The array of custom headers.</body></ownedComment></ownedAttribute><ownedAttribute xmi:type="uml:Property" name="$lastMessageID" xmi:id="63a4c6d2131b42.40868430" visibility="protected" ><type xmi:idref="63a4c6d209e2b6.20155476"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21dc3c0.59925100" value="&#039;&#039;" /><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21dc3e1.34069730" annotatedElement="63a4c6d2131b42.40868430"><body>The most recent Message-ID (including angular brackets).</body></ownedComment></ownedAttribute><ownedAttribute xmi:type="uml:Property" name="$message_type" xmi:id="63a4c6d2131d06.97166205" visibility="protected" ><type xmi:idref="63a4c6d209e2b6.20155476"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21dc410.48287366" value="&#039;&#039;" /><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21dc435.00020919" annotatedElement="63a4c6d2131d06.97166205"><body>The message's MIME type.</body></ownedComment></ownedAttribute><ownedAttribute xmi:type="uml:Property" name="$boundary" xmi:id="63a4c6d2131ed1.56065113" visibility="protected" ><type xmi:idref="63a4c6d209e232.56111258"/><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21dc485.06167999" annotatedElement="63a4c6d2131ed1.56065113"><body>The array of MIME boundary strings.</body></ownedComment></ownedAttribute><ownedAttribute xmi:type="uml:Property" name="$language" xmi:id="63a4c6d21320e3.27864207" visibility="protected" ><type xmi:idref="63a4c6d209e232.56111258"/><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21dc4d4.75217844" annotatedElement="63a4c6d21320e3.27864207"><body>The array of available text strings for the current language.</body></ownedComment></ownedAttribute><ownedAttribute xmi:type="uml:Property" name="$error_count" xmi:id="63a4c6d21322b8.87441224" visibility="protected" ><type xmi:idref="63a4c6d209e2f2.35908695"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21dc4f5.11644273" value="0" /><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21dc520.34898906" annotatedElement="63a4c6d21322b8.87441224"><body>The number of errors encountered.</body></ownedComment></ownedAttribute><ownedAttribute xmi:type="uml:Property" name="$sign_cert_file" xmi:id="63a4c6d2132472.42302977" visibility="protected" ><type xmi:idref="63a4c6d209e2b6.20155476"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21dc547.57932616" value="&#039;&#039;" /><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21dc576.28114948" annotatedElement="63a4c6d2132472.42302977"><body>The S/MIME certificate file path.</body></ownedComment></ownedAttribute><ownedAttribute xmi:type="uml:Property" name="$sign_key_file" xmi:id="63a4c6d2132630.15897369" visibility="protected" ><type xmi:idref="63a4c6d209e2b6.20155476"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21dc593.38271387" value="&#039;&#039;" /><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21dc5b0.23806202" annotatedElement="63a4c6d2132630.15897369"><body>The S/MIME key file path.</body></ownedComment></ownedAttribute><ownedAttribute xmi:type="uml:Property" name="$sign_extracerts_file" xmi:id="63a4c6d2132873.47315936" visibility="protected" ><type xmi:idref="63a4c6d209e2b6.20155476"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21dc5e1.53905945" value="&#039;&#039;" /><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21dc601.26050855" annotatedElement="63a4c6d2132873.47315936"><body>The optional S/MIME extra certificates (&quot;CA Chain&quot;) file path.</body></ownedComment></ownedAttribute><ownedAttribute xmi:type="uml:Property" name="$sign_key_pass" xmi:id="63a4c6d2132aa5.97849159" visibility="protected" ><type xmi:idref="63a4c6d209e2b6.20155476"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21dc630.45205507" value="&#039;&#039;" /><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21dc656.50589407" annotatedElement="63a4c6d2132aa5.97849159"><body>The S/MIME password for the key.
Used only if the key is encrypted.</body></ownedComment></ownedAttribute><ownedAttribute xmi:type="uml:Property" name="$exceptions" xmi:id="63a4c6d2132c72.73635985" visibility="protected" ><type xmi:idref="63a4c6d209e377.76986812"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21dc682.13155113" value="false" /><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21dc6a2.70364465" annotatedElement="63a4c6d2132c72.73635985"><body>Whether to throw exceptions for errors.</body></ownedComment></ownedAttribute><ownedAttribute xmi:type="uml:Property" name="$uniqueid" xmi:id="63a4c6d2132e61.10257211" visibility="protected" ><type xmi:idref="63a4c6d209e2b6.20155476"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21dc6d1.16922193" value="&#039;&#039;" /><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21dc6f0.53625184" annotatedElement="63a4c6d2132e61.10257211"><body>Unique ID used for message ID and boundaries.</body></ownedComment></ownedAttribute><ownedAttribute xmi:type="uml:Property" name="VERSION" xmi:id="63a4c6d2133013.00962596" visibility="public"  isStatic="true" isReadOnly="true" ><type xmi:idref="63a4c6d209e2b6.20155476"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21dc729.40025369" value="&#039;6.7.1&#039;" /><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21dc745.00021794" annotatedElement="63a4c6d2133013.00962596"><body>The PHPMailer Version number.</body></ownedComment></ownedAttribute><ownedAttribute xmi:type="uml:Property" name="STOP_MESSAGE" xmi:id="63a4c6d2133221.65575587" visibility="public"  isStatic="true" isReadOnly="true" ><type xmi:idref="63a4c6d209e2f2.35908695"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21dc779.64514067" value="0" /><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21dc792.82253718" annotatedElement="63a4c6d2133221.65575587"><body>Error severity: message only, continue processing.</body></ownedComment></ownedAttribute><ownedAttribute xmi:type="uml:Property" name="STOP_CONTINUE" xmi:id="63a4c6d2133432.82859913" visibility="public"  isStatic="true" isReadOnly="true" ><type xmi:idref="63a4c6d209e2f2.35908695"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21dc7c7.98794126" value="1" /><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21dc7f8.96319825" annotatedElement="63a4c6d2133432.82859913"><body>Error severity: message, likely ok to continue processing.</body></ownedComment></ownedAttribute><ownedAttribute xmi:type="uml:Property" name="STOP_CRITICAL" xmi:id="63a4c6d2133641.57210983" visibility="public"  isStatic="true" isReadOnly="true" ><type xmi:idref="63a4c6d209e2f2.35908695"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21dc817.20134786" value="2" /><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21dc841.40021900" annotatedElement="63a4c6d2133641.57210983"><body>Error severity: message, plus full stop, critical error reached.</body></ownedComment></ownedAttribute><ownedAttribute xmi:type="uml:Property" name="CRLF" xmi:id="63a4c6d2133897.74309490" visibility="public"  isStatic="true" isReadOnly="true" ><type xmi:idref="63a4c6d209e2b6.20155476"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21dc871.36045420" value="&quot;\r\n&quot;" /><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21dc898.43596629" annotatedElement="63a4c6d2133897.74309490"><body>The SMTP standard CRLF line break.
If you want to change line break format, change static::$LE, not this.</body></ownedComment></ownedAttribute><ownedAttribute xmi:type="uml:Property" name="FWS" xmi:id="63a4c6d2133a46.01053456" visibility="public"  isStatic="true" isReadOnly="true" ><type xmi:idref="63a4c6d209e2b6.20155476"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21dc8d3.34274688" value="&#039; &#039;" /><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21dc8f5.57811440" annotatedElement="63a4c6d2133a46.01053456"><body>&quot;Folding White Space&quot; a white space string used for line folding.</body></ownedComment></ownedAttribute><ownedAttribute xmi:type="uml:Property" name="$LE" xmi:id="63a4c6d2133cb1.93804247" visibility="protected"  isStatic="true"><type xmi:idref="63a4c6d209e2b6.20155476"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21dc928.31765701" value="selfCRLF" /><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21dc949.40022352" annotatedElement="63a4c6d2133cb1.93804247"><body>SMTP RFC standard line ending; Carriage Return, Line Feed.</body></ownedComment></ownedAttribute><ownedAttribute xmi:type="uml:Property" name="MAIL_MAX_LINE_LENGTH" xmi:id="63a4c6d2134024.92610559" visibility="public"  isStatic="true" isReadOnly="true" ><type xmi:idref="63a4c6d209e2f2.35908695"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21dc977.22234680" value="63" /><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21dc9a4.93949570" annotatedElement="63a4c6d2134024.92610559"><body>The maximum line length supported by mail().

Background: mail() will sometimes corrupt messages with headers headers longer than 65 chars, see #818.</body></ownedComment></ownedAttribute><ownedAttribute xmi:type="uml:Property" name="MAX_LINE_LENGTH" xmi:id="63a4c6d2134230.14418876" visibility="public"  isStatic="true" isReadOnly="true" ><type xmi:idref="63a4c6d209e2f2.35908695"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21dc9d2.85680941" value="998" /><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21dca05.17227023" annotatedElement="63a4c6d2134230.14418876"><body>The maximum line length allowed by RFC 2822 section 2.1.1.</body></ownedComment></ownedAttribute><ownedAttribute xmi:type="uml:Property" name="STD_LINE_LENGTH" xmi:id="63a4c6d21345c4.98810576" visibility="public"  isStatic="true" isReadOnly="true" ><type xmi:idref="63a4c6d209e2f2.35908695"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21dca39.53275147" value="76" /><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21dca50.59919315" annotatedElement="63a4c6d21345c4.98810576"><body>The lower maximum line length allowed by RFC 2822 section 2.1.1.
This length does NOT include the line break 76 means that lines will be 77 or 78 chars depending on whether the line break format is LF or CRLF; both are valid.</body></ownedComment></ownedAttribute><ownedOperation xmi:id="63a4c6d21347e4.64200254" 
            name="__construct" visibility="public" ><ownedParameter xmi:id="63a4c6d21348b8.36843333" name="return" direction="return"><type xmi:idref="63a4c6d209e429.79234751"/></ownedParameter><ownedParameter xmi:id="63a4c6d21348f4.41935805" name="$exceptions" direction="in"><type xmi:idref="63a4c6d209e377.76986812"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21dcad3.99020989" value="null" /></ownedParameter><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21dcaf8.39619391" annotatedElement="63a4c6d21347e4.64200254"><body>Constructor.</body></ownedComment></ownedOperation><ownedOperation xmi:id="63a4c6d2134b48.75786134" 
            name="__destruct" visibility="public" ><ownedParameter xmi:id="63a4c6d2134bd8.52855051" name="return" direction="return"><type xmi:idref="63a4c6d209e429.79234751"/></ownedParameter><ownedComment xmi:type="uml:Comment"
