4"><var>int</var></php:docblock><php:docblock base_Element="63a4c6d2189727.20463087"><var>string[]</var></php:docblock><php:docblock base_Element="63a4c6d2189f20.65251963"><var>string|bool|null</var></php:docblock><php:docblock base_Element="63a4c6d218a145.17549996"><var>?resource</var></php:docblock><php:docblock base_Element="63a4c6d218a365.41251376"><var>array</var></php:docblock><php:docblock base_Element="63a4c6d218a702.88222285"><var>string|null</var></php:docblock><php:docblock base_Element="63a4c6d218abf9.00210260"><var>array|null</var></php:docblock><php:docblock base_Element="63a4c6d218ae20.75496647"><var>string</var></php:docblock><php:docblock base_Element="63a4c6d218b171.76703800"><param>string $str Debug string to output</param><param>int $level The debug level of this message; see DEBUG_* constants</param><see>SMTP::$Debugoutput</see><see>SMTP::$do_debug</see></php:docblock><php:docblock base_Element="63a4c6d218bc32.70744181"><param>string $host SMTP server IP or host name</param><param>int $port The port number to connect to</param><param>int $timeout How long to wait for the connection to open</param><param>array $options An array of options for stream_context_create()</param><return>bool</return></php:docblock><php:docblock base_Element="63a4c6d218c8c3.57007523"><param>string $host SMTP server IP or host name</param><param>int $port The port number to connect to</param><param>int $timeout How long to wait for the connection to open</param><param>array $options An array of options for stream_context_create()</param><return>false|resource</return></php:docblock><php:docblock base_Element="63a4c6d218d426.38359044"><return>bool</return></php:docblock><php:docblock base_Element="63a4c6d218dbf2.02755095"><see>hello()</see><param>string $username The user name</param><param>string $password The password</param><param>string $authtype The auth type (CRAM-MD5, PLAIN, LOGIN, XOAUTH2)</param><param>OAuthTokenProvider $OAuth An optional OAuthTokenProvider instance for XOAUTH2 authentication</param><return>bool True if successfully authenticated</return></php:docblock><php:docblock base_Element="63a4c6d218f217.68576108"><param>string $data The data to hash</param><param>string $key The key to hash with</param><return>string</return></php:docblock><php:docblock base_Element="63a4c6d218f968.28311467"><return>bool True if connected</return></php:docblock><php:docblock base_Element="63a4c6d218fdd6.43594334"><see>quit()</see></php:docblock><php:docblock base_Element="63a4c6d21904c3.91058481"><param>string $msg_data Message data to send</param><return>bool</return></php:docblock><php:docblock base_Element="63a4c6d2191475.49836495"><param>string $host The host name or IP to connect to</param><return>bool</return></php:docblock><php:docblock base_Element="63a4c6d2191a78.73455010"><param>string $hello The HELO string</param><param>string $host The hostname to say we are</param><return>bool</return><see>hello()</see></php:docblock><php:docblock base_Element="63a4c6d2192044.49223738"><param>string $type `HELO` or `EHLO`</param></php:docblock><php:docblock base_Element="63a4c6d2192af0.25390768"><param>string $from Source address of this message</param><return>bool</return></php:docblock><php:docblock base_Element="63a4c6d2193062.13990899"><param>bool $close_on_error Should the connection close if an error occurs?</param><return>bool</return></php:docblock><php:docblock base_Element="63a4c6d21938b7.45862740"><param>string $address The address the message is being sent to</param><param>string $dsn Comma separated list of DSN notifications. NEVER, SUCCESS, FAILURE</param><return>bool</return></php:docblock><php:docblock base_Element="63a4c6d21940b5.13092379"><return>bool True on success</return></php:docblock><php:docblock base_Element="63a4c6d2194592.24747875"><param>string $command The command name - not sent to the server</param><param>string $commandstring The actual command to send</param><param>int|array $expect One or more expected integer success codes</param><return>bool True on success</return></php:docblock><php:docblock base_Element="63a4c6d2195668.43383933"><param>string $from The address the message is from</param><return>bool</return></php:docblock><php:docblock base_Element="63a4c6d2195a21.50405205"><param>string $name The name to verify</param><return>bool</return></php:docblock><php:docblock base_Element="63a4c6d2195d92.58393317"><return>bool</return></php:docblock><php:docblock base_Element="63a4c6d2196208.27561942"><return>bool</return></php:docblock><php:docblock base_Element="63a4c6d21966b6.65626699"><param>string $data The data to send</param><param>string $command Optionally, the command this is part of, used only for controlling debug output</param><return>int|bool The number of bytes sent to the server or false on error</return></php:docblock><php:docblock base_Element="63a4c6d2196c46.45413827"><return>array</return></php:docblock><php:docblock base_Element="63a4c6d2196e84.54774857"><return>array|null</return></php:docblock><php:docblock base_Element="63a4c6d21976f3.94603495"><param>string $name Name of SMTP extension or 'HELO'|'EHLO'</param><return>string|bool|null</return></php:docblock><php:docblock base_Element="63a4c6d2197c91.02067296"><return>string</return></php:docblock><php:docblock base_Element="63a4c6d21980b5.47551192"><return>string</return></php:docblock><php:docblock base_Element="63a4c6d2198e06.75249610"><param>bool $enabled</param></php:docblock><php:docblock base_Element="63a4c6d2199097.16868913"><return>bool</return></php:docblock><php:docblock base_Element="63a4c6d2199474.42474186"><param>string $message The error message</param><param>string $detail Further detail on the error</param><param>string $smtp_code An associated SMTP error code</param><param>string $smtp_code_ex Extended SMTP code</param></php:docblock><php:docblock base_Element="63a4c6d2199a22.91317850"><param>string|callable $method The name of the mechanism to use for debugging output, or a callable to handle it</param></php:docblock><php:docblock base_Element="63a4c6d2199ca2.91331593"><return>string</return></php:docblock><php:docblock base_Element="63a4c6d2199eb8.57672367"><param>int $level</param></php:docblock><php:docblock base_Element="63a4c6d219a118.12133369"><return>int</return></php:docblock><php:docblock base_Element="63a4c6d219a377.63365038"><param>int $timeout The timeout duration in seconds</param></php:docblock><php:docblock base_Element="63a4c6d219a5c2.35395375"><return>int</return></php:docblock><php:docblock base_Element="63a4c6d219a9e6.48988176"><param>int $errno The error number returned by PHP</param><param>string $errmsg The error message returned by PHP</param><param>string $errfile The file the error occurred in</param><param>int $errline The line number the error occurred on</param></php:docblock><php:docblock base_Element="63a4c6d219b136.68647941"><return>bool|string|null</return></php:docblock><php:docblock base_Element="63a4c6d219b781.98251411"><return>bool|string|null</return><see>recordLastTransactionID()</see></php:docblock></xmi:XMI>