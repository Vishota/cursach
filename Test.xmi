ock base_Element="63a4c6d213f694.82685649"><throws>Exception</throws><return>bool false on error - See the ErrorInfo property for details of the error</return></php:docblock><php:docblock base_Element="63a4c6d213faf2.02188753"><throws>Exception</throws><return>bool</return></php:docblock><php:docblock base_Element="63a4c6d2141183.93885206"><throws>Exception</throws><return>bool</return></php:docblock><php:docblock base_Element="63a4c6d2141a89.15522531"><see>PHPMailer::$Sendmail</see><param>string $header The message headers</param><param>string $body The message body</param><throws>Exception</throws><return>bool</return></php:docblock><php:docblock base_Element="63a4c6d2143298.20649242"><see>https://github.com/PHPMailer/PHPMailer/issues/924 CVE-2016-10045 bug report</see><param>string $string The string to be validated</param><return>bool</return></php:docblock><php:docblock base_Element="63a4c6d2143c55.30472208"><param>string $path A relative or absolute path to a file</param><return>bool</return></php:docblock><php:docblock base_Element="63a4c6d21440c9.44610780"><param>string $path A relative or absolute path to a file</param><return>bool</return></php:docblock><php:docblock base_Element="63a4c6d2144679.38120569"><see>http://www.php.net/manual/en/book.mail.php</see><param>string $header The message headers</param><param>string $body The message body</param><throws>Exception</throws><return>bool</return></php:docblock><php:docblock base_Element="63a4c6d21455a2.64509577"><return>SMTP</return></php:docblock><php:docblock base_Element="63a4c6d21458a0.78404849"><return>SMTP</return></php:docblock><php:docblock base_Element="63a4c6d2145dd6.57454152"><see>PHPMailer::setSMTPInstance() to use a different class.</see><uses>\PHPMailer\PHPMailer\SMTP</uses><param>string $header The message headers</param><param>string $body The message body</param><throws>Exception</throws><return>bool</return></php:docblock><php:docblock base_Element="63a4c6d2147074.79702825"><param>array $options An array of options compatible with stream_context_create()</param><throws>Exception</throws><uses>\PHPMailer\PHPMailer\SMTP</uses><return>bool</return></php:docblock><php:docblock base_Element="63a4c6d2148e90.84142649"><param>string $langcode ISO 639-1 2-character language code (e.g. French is &quot;fr&quot;)</param><param>string $lang_path Path to the language file directory, with trailing separator (slash)</param><return>bool Returns true if the requested language was loaded, false otherwise.</return></php:docblock><php:docblock base_Element="63a4c6d214a176.33389938"><return>array</return></php:docblock><php:docblock base_Element="63a4c6d214a767.07795691"><param>string $type</param><param>array $addr An array of recipients,</param><return>string</return></php:docblock><php:docblock base_Element="63a4c6d214ad62.16645880"><param>array $addr A 2-element indexed array, element 0 containing an address, element 1 containing a name like</param><return>string</return></php:docblock><php:docblock base_Element="63a4c6d214b457.90378291"><param>string $message The message to wrap</param><param>int $length The line length to wrap to</param><param>bool $qp_mode Whether to run in Quoted-Printable mode</param><return>string</return></php:docblock><php:docblock base_Element="63a4c6d214c9c9.63133190"><param>string $encodedText utf-8 QP text</param><param>int $maxLength Find the last character boundary prior to this length</param><return>int</return></php:docblock><php:docblock base_Element="63a4c6d214d7d9.26858372"><return>string The assembled headers</return></php:docblock><php:docblock base_Element="63a4c6d214e9d9.21314128"><return>string</return></php:docblock><php:docblock base_Element="63a4c6d2154551.14769421"><see>PHPMailer::preSend()</see><return>string</return></php:docblock><php:docblock base_Element="63a4c6d2154986.66546762"><return>string</return></php:docblock><php:docblock base_Element="63a4c6d2154ff1.01690423"><throws>Exception</throws><return>string The assembled message body</return></php:docblock><php:docblock base_Element="63a4c6d2158344.27506895"><return>array</return></php:docblock><php:docblock base_Element="63a4c6d2158711.32406098"><param>string $boundary</param><param>string $charSet</param><param>string $contentType</param><param>string $encoding</param><return>string</return></php:docblock><php:docblock base_Element="63a4c6d2158e76.92402244"><param>string $boundary</param><return>string</return></php:docblock><php:docblock base_Element="63a4c6d2159691.34279295"><param>string $name</param><param>string|int $value</param><return>string</return></php:docblock><php:docblock base_Element="63a4c6d21599f6.16711590"><param>string $value</param><return>string</return></php:docblock><php:docblock base_Element="63a4c6d215a273.91725782"><param>string $path Path to the attachment</param><param>string $name Overrides the attachment name</param><param>string $encoding File encoding (see $Encoding)</param><param>string $type MIME type, e.g. `image/jpeg`; determined automatically from $path if not specified</param><param>string $disposition Disposition to use</param><throws>Exception</throws><return>bool</return></php:docblock><php:docblock base_Element="63a4c6d215ad07.77637981"><return>array</return></php:docblock><php:docblock base_Element="63a4c6d215b0c0.05342392"><param>string $disposition_type</param><param>string $boundary</param><throws>Exception</throws><return>string</return></php:docblock><php:docblock base_Element="63a4c6d215c491.79476748"><param>string $path The full path to the file</param><param>string $encoding The encoding to use; one of 'base64', '7bit', '8bit', 'binary', 'quoted-printable'</param><return>string</return></php:docblock><php:docblock base_Element="63a4c6d215cd55.34805227"><param>string $str The text to encode</param><param>string $encoding The encoding to use; one of 'base64', '7bit', '8bit', 'binary', 'quoted-printable'</param><throws>Exception</throws><return>string</return></php:docblock><php