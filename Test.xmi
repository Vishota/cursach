                xmi:id="63a4c6d21e0f95.95469796" annotatedElement="63a4c6d217de97.50938558"><body>Debug level to show server -&gt; client messages also shows clients connection errors or errors from server</body></ownedComment></ownedAttribute><ownedAttribute xmi:type="uml:Property" name="DEBUG_CLIENT" xmi:id="63a4c6d217e114.81981517" visibility="public"  isStatic="true" isReadOnly="true" ><type xmi:idref="63a4c6d209e2f2.35908695"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21e0fc9.33566075" value="2" /><ownedComment xmi:type="uml:Comment"
