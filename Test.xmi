            name="addReplyTo" visibility="public" ><ownedParameter xmi:id="63a4c6d2138238.84103095" name="return" direction="return"><type xmi:idref="63a4c6d209e377.76986812"/></ownedParameter><ownedParameter xmi:id="63a4c6d2138263.80721574" name="$address" direction="in"><type xmi:idref="63a4c6d209e2b6.20155476"/></ownedParameter><ownedParameter xmi:id="63a4c6d21382c2.83806832" name="$name" direction="in"><type xmi:idref="63a4c6d209e2b6.20155476"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21dd0c2.23016989" value="&#039;&#039;" /></ownedParameter><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21dd0e5.38098144" annotatedElement="63a4c6d2138129.17354355"><body>Add a &quot;Reply-To&quot; address.</body></ownedComment></ownedOperation><ownedOperation xmi:id="63a4c6d21389f7.11799246" 
            name="addOrEnqueueAnAddress" visibility="protected" ><ownedParameter xmi:id="63a4c6d2138b89.81454665" name="return" direction="return"><type xmi:idref="63a4c6d209e377.76986812"/></ownedParameter><ownedParameter xmi:id="63a4c6d2138bb6.72862141" name="$kind" direction="in"><type xmi:idref="63a4c6d209e2b6.20155476"/></ownedParameter><ownedParameter xmi:id="63a4c6d2138bf5.83132419" name="$address" direction="in"><type xmi:idref="63a4c6d209e2b6.20155476"/></ownedParameter><ownedParameter xmi:id="63a4c6d2138c31.94446708" name="$name" direction="in"><type xmi:idref="63a4c6d209e2b6.20155476"/></ownedParameter><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21dd199.42182493" annotatedElement="63a4c6d21389f7.11799246"><body>Add an address to one of the recipient arrays or to the ReplyTo array. Because PHPMailer can't validate addresses with an IDN without knowing the PHPMailer::$CharSet (that can still be modified after calling this function), addition of such addresses is delayed until send().
Addresses that have been added already return false, but do not throw exceptions.</body></ownedComment></ownedOperation><ownedOperation xmi:id="63a4c6d2139719.23577213" 
            name="setBoundaries" visibility="public" ><ownedParameter xmi:id="63a4c6d21397e1.17069818" name="return" direction="return"><type xmi:idref="63a4c6d209e429.79234751"/></ownedParameter><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21dd218.14520805" annotatedElement="63a4c6d2139719.23577213"><body>Set the boundaries to use for delimiting MIME parts.
If you override this, ensure you set all 3 boundaries to unique values.
The default boundaries include a &quot;=_&quot; sequence which cannot occur in quoted-printable bodies, as suggested by https://www.rfc-editor.org/rfc/rfc2045#section-6.7</body></ownedComment></ownedOperation><ownedOperation xmi:id="63a4c6d2139df9.52904426" 
            name="addAnAddress" visibility="protected" ><ownedParameter xmi:id="63a4c6d2139f41.44104136" name="return" direction="return"><type xmi:idref="63a4c6d209e377.76986812"/></ownedParameter><ownedParameter xmi:id="63a4c6d2139f71.90265575" name="$kind" direction="in"><type xmi:idref="63a4c6d209e2b6.20155476"/></ownedParameter><ownedParameter xmi:id="63a4c6d2139fb9.38639148" name="$address" direction="in"><type xmi:idref="63a4c6d209e2b6.20155476"/></ownedParameter><ownedParameter xmi:id="63a4c6d213a010.53888075" name="$name" direction="in"><type xmi:idref="63a4c6d209e2b6.20155476"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21dd2c2.46330249" value="&#039;&#039;" /></ownedParameter><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21dd2f6.34035912" annotatedElement="63a4c6d2139df9.52904426"><body>Add an address to one of the recipient arrays or to the ReplyTo array.
Addresses that have been added already return false, but do not throw exceptions.</body></ownedComment></ownedOperation><ownedOperation xmi:id="63a4c6d213b099.82555731" 
            name="parseAddresses" visibility="public"  isStatic="true"><ownedParameter xmi:id="63a4c6d213b202.57206018" name="return" direction="return"><type xmi:idref="63a4c6d209e232.56111258"/></ownedParameter><ownedParameter xmi:id="63a4c6d213b233.62505138" name="$addrstr" direction="in"><type xmi:idref="63a4c6d209e2b6.20155476"/></ownedParameter><ownedParameter xmi:id="63a4c6d213b293.07297763" name="$useimap" direction="in"><type xmi:idref="63a4c6d209e377.76986812"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21dd384.54959662" value="true" /></ownedParameter><ownedParameter xmi:id="63a4c6d213b2f5.82673959" name="$charset" direction="in"><type xmi:idref="63a4c6d209e2b6.20155476"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21dd3b4.10073745" value="selfCHARSET_ISO88591" /></ownedParameter><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21dd3d5.01108358" annotatedElement="63a4c6d213b099.82555731"><body>Parse and validate a string containing one or more RFC822-style comma-separated email addresses of the form &quot;display name &lt;address&gt;&quot; into an array of name/address pairs.
Uses the imap_rfc822_parse_adrlist function if the IMAP extension is available.
Note that quotes in the name part are removed.</body></ownedComment></ownedOperation><ownedOperation xmi:id="63a4c6d213c191.60212042" 
            name="setFrom" visibility="public" ><ownedParameter xmi:id="63a4c6d213c2c2.38399996" name="return" direction="return"><type xmi:idref="63a4c6d209e377.76986812"/></ownedParameter><ownedParameter xmi:id="63a4c6d213c2f3.71285038" name="$address" direction="in"><type xmi:idref="63a4c6d209e2b6.20155476"/></ownedParameter><ownedParameter xmi:id="63a4c6d213c367.03713316" name="$name" direction="in"><type xmi:idref="63a4c6d209e2b6.20155476"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21dd476.36857864" value="&#039;&#039;" /></ownedParameter><ownedParameter xmi:id="63a4c6d213c3b7.07850482" name="$auto" direction="in"><type xmi:idref="63a4c6d209e377.76986812"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21dd493.12720470" value="true" /></ownedParameter><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21dd4b5.09617453" annotatedElement="63a4c6d213c191.60212042"><body>Set the From and FromName properties.</body></ownedComment></ownedOperation><ownedOperation xmi:id="63a4c6d213cbb3.87387506" 
            name="getLastMessageID" visibility="public" ><ownedParameter xmi:id="63a4c6d213cc80.05327278" name="return" direction="return"><type xmi:idref="63a4c6d209e2b6.20155476"/></ownedParameter><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21dd513.73871216" annotatedElement="63a4c6d213cbb3.87387506"><body>Return the Message-ID header of the last email.
Technically this is the value from the last time the headers were created, but it's also the message ID of the last sent message except in pathological cases.</body></ownedComment></ownedOperation><ownedOperation xmi:id="63a4c6d213dab6.88915847" 
            name="validateAddress" visibility="public"  isStatic="true"><ownedParameter xmi:id="63a4c6d213dc59.07377749" name="return" direction="return"><type xmi:idref="63a4c6d209e377.76986812"/></ownedParameter><ownedParameter xmi:id="63a4c6d213dc88.18351969" name="$address" direction="in"><type xmi:idref="63a4c6d209e2b6.20155476"/></ownedParameter><ownedParameter xmi:id="63a4c6d213dce8.14568531" name="$patternselect" direction="in"><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21dd594.70916003" value="null" /></ownedParameter><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21dd5c7.38217643" annotatedElement="63a4c6d213dab6.88915847"><body>Check that a string looks like an email address.
Validation patterns supported:
* `auto` Pick best pattern automatically; * `pcre8` Use the squiloople.com pattern, requires PCRE &gt; 8.0; * `pcre` Use old PCRE implementation; * `php` Use PHP built-in FILTER_VALIDATE_EMAIL; * `html5` Use the pattern given by the HTML5 spec for 'email' type form input elements.
* `noregex` Don't use a regex: super fast, really dumb.
Alternatively you may pass in a callable to inject your own validator, for example:

```php PHPMailer::validateAddress('user@example.com', function($address) { return (strpos($address, '@') !== false); }); ``` 
You can also set the PHPMailer::$validator static to a callable, allowing built-in methods to use your validator.</body></ownedComment></ownedOperation><ownedOperation xmi:id="63a4c6d213e525.01366076" 
            name="idnSupported" visibility="public"  isStatic="true"><ownedParameter xmi:id="63a4c6d213e5e7.14397615" name="return" direction="return"><type xmi:idref="63a4c6d209e377.76986812"/></ownedParameter><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21dd694.45553171" annotatedElement="63a4c6d213e525.01366076"><body>Tells whether IDNs (Internationalized Domain Names) are supported or not. This requires the `intl` and `mbstring` PHP extensions.</body></ownedComment></ownedOperation><ownedOperation xmi:id="63a4c6d213ecf2.62663035" 
            name="punyencodeAddress" visibility="public" ><ownedParameter xmi:id="63a4c6d213ee26.09790641" name="return" direction="return"><type xmi:idref="63a4c6d209e2b6.20155476"/></ownedParameter><ownedParameter xmi:id="63a4c6d213ee56.11217123" name="$address" direction="in"><type xmi:idref="63a4c6d209e2b6.20155476"/></ownedParameter><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21dd712.43715491" annotatedElement="63a4c6d213ecf2.62663035"><body>Converts IDN in given email address to its ASCII form, also known as punycode, if possible.
Important: Address must be passed in same encoding as currently set in PHPMailer::$CharSet.
This function silently returns unmodified address if:
- No conversion is necessary (i.e. domain name is not an IDN, or is already in ASCII form) - Conversion to punycode is impossible (e.g. required PHP functions are not available) or fails for any reason (e.g. domain contains characters not allowed in an IDN).</body></ownedComment></ownedOperation><ownedOperation xmi:id="63a4c6d213f694.82685649" 
            name="send" visibility="public" ><ownedParameter xmi:id="63a4c6d213f764.66412161" name="return" direction="return"><type xmi:idref="63a4c6d209e377.76986812"/></ownedParameter><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21dd7a9.52336355" annotatedElement="63a4c6d213f694.82685649"><body>Create a message and send it.
Uses the sending method specified by $Mailer.</body></ownedComment></ownedOperation><ownedOperation xmi:id="63a4c6d213faf2.02188753" 
            name="preSend" visibility="public" ><ownedParameter xmi:id="63a4c6d213fbb6.52801341" name="return" direction="return"><type xmi:idref="63a4c6d209e377.76986812"/></ownedParameter><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21dd801.74267092" annotatedElement="63a4c6d213faf2.02188753"><body>Prepare a message for sending.</body></ownedComment></ownedOperation><ownedOperation xmi:id="63a4c6d2141183.93885206" 
            name="postSend" visibility="public" ><ownedParameter xmi:id="63a4c6d2141258.81454653" name="return" direction="return"><type xmi:idref="63a4c6d209e377.76986812"/></ownedParameter><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21dd857.02382457" annotatedElement="63a4c6d2141183.93885206"><body>Actually send a message via the selected mechanism.</body></ownedComment></ownedOperation><ownedOperation xmi:id="63a4c6d2141a89.15522531" 
            name="sendmailSend" visibility="protected" ><ownedParameter xmi:id="63a4c6d2141bc7.93617782" name="return" direction="return"><type xmi:idref="63a4c6d209e377.76986812"/></ownedParameter><ownedParameter xmi:id="63a4c6d2141bf1.75154856" name="$header" direction="in"><type xmi:idref="63a4c6d209e2b6.20155476"/></ownedParameter><ownedParameter xmi:id="63a4c6d2141c32.57544517" name="$body" direction="in"><type xmi:idref="63a4c6d209e2b6.20155476"/></ownedParameter><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21dd922.52351324" annotatedElement="63a4c6d2141a89.15522531"><body>Send mail using the $Sendmail program.</body></ownedComment></ownedOperation><ownedOperation xmi:id="63a4c6d2143298.20649242" 
            name="isShellSafe" visibility="protected"  isStatic="true"><ownedParameter xmi:id="63a4c6d21433f6.78815752" name="return" direction="return"><type xmi:idref="63a4c6d209e377.76986812"/></ownedParameter><ownedParameter xmi:id="63a4c6d2143421.79018261" name="$string" direction="in"><type xmi:idref="63a4c6d209e2b6.20155476"/></ownedParameter><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21dd994.16305175" annotatedElement="63a4c6d2143298.20649242"><body>Fix CVE-2016-10033 and CVE-2016-10045 by disallowing potentially unsafe shell characters.
Note that escapeshellarg and escapeshellcmd are inadequate for our purposes, especially on Windows.</body></ownedComment></ownedOperation><ownedOperation xmi:id="63a4c6d2143c55.30472208" 
            name="isPermittedPath" visibility="protected"  isStatic="true"><ownedParameter xmi:id="63a4c6d2143d48.02647128" name="return" direction="return"><type xmi:idref="63a4c6d209e377.76986812"/></ownedParameter><ownedParameter xmi:id="63a4c6d2143d75.10233466" name="$path" direction="in"><type xmi:idref="63a4c6d209e2b6.20155476"/></ownedParameter><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21dda22.53125737" annotatedElement="63a4c6d2143c55.30472208"><body>Check whether a file path is of a permitted type.
Used to reject URLs and phar files from functions that access local file paths, such as addAttachment.</body></ownedComment></ownedOperation><ownedOperation xmi:id="63a4c6d21440c9.44610780" 
            name="fileIsAccessible" visibility="protected"  isStatic="true"><ownedParameter xmi:id="63a4c6d21441a7.93592892" name="return" direction="return"><type xmi:idref="63a4c6d209e377.76986812"/></ownedParameter><ownedParameter xmi:id="63a4c6d21441c1.32367756" name="$path" direction="in"><type xmi:idref="63a4c6d209e2b6.20155476"/></ownedParameter><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21ddaa8.72781844" annotatedElement="63a4c6d21440c9.44610780"><body>Check whether a file path is safe, accessible, and readable.</body></ownedComment></ownedOperation><ownedOperation xmi:id="63a4c6d2144679.38120569" 
            name="mailSend" visibility="protected" ><ownedParameter xmi:id="63a4c6d21447b7.56071312" name="return" direction="return"><type xmi:idref="63a4c6d209e377.76986812"/></ownedParameter><ownedParameter xmi:id="63a4c6d21447e4.21169797" name="$header" direction="in"><type xmi:idref="63a4c6d209e2b6.20155476"/></ownedParameter><ownedParameter xmi:id="63a4c6d2144827.07058571" name="$body" direction="in"><type xmi:idref="63a4c6d209e2b6.20155476"/></ownedParameter><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21ddb38.48997943" annotatedElement="63a4c6d2144679.38120569"><body>Send mail using the PHP mail() function.</body></ownedComment></ownedOperation><ownedOperation xmi:id="63a4c6d21455a2.64509577" 
            name="getSMTPInstance" visibility="public" ><ownedParameter xmi:id="63a4c6d2145661.92542525" name="return" direction="return"><type xmi:idref="63a4c6d2186547.70864334"/></ownedParameter><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21ddb85.89202285" annotatedElement="63a4c6d21455a2.64509577"><body>Get an instance to use for SMTP operations.
Override this function to load your own SMTP implementation, or set one with setSMTPInstance.</body></ownedComment></ownedOperation><ownedOperation xmi:id="63a4c6d21458a0.78404849" 
            name="setSMTPInstance" visibility="public" ><ownedParameter xmi:id="63a4c6d2145953.75695433" name="return" direction="return"><type xmi:idref="63a4c6d2186547.70864334"/></ownedParameter><ownedParameter xmi:id="63a4c6d2145985.92515705" name="$smtp" direction="in"><type xmi:idref="63a4c6d2186547.70864334"/></ownedParameter><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21ddc13.29099642" annotatedElement="63a4c6d21458a0.78404849"><body>Provide an instance to use for SMTP operations.</body></ownedComment></ownedOperation><ownedOperation xmi:id="63a4c6d2145dd6.57454152" 
            name="smtpSend" visibility="protected" ><ownedParameter xmi:id="63a4c6d2145f47.58024404" name="return" direction="return"><type xmi:idref="63a4c6d209e377.76986812"/></ownedParameter><ownedParameter xmi:id="63a4c6d2145f78.39039951" name="$header" direction="in"><type xmi:idref="63a4c6d209e2b6.20155476"/></ownedParameter><ownedParameter xmi:id="63a4c6d2145fb8.93314520" name="$body" direction="in"><type xmi:idref="63a4c6d209e2b6.20155476"/></ownedParameter><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21ddca7.32538027" annotatedElement="63a4c6d2145dd6.57454152"><body>Send mail via SMTP.
Returns false if there is a bad MAIL FROM, RCPT, or DATA input.</body></ownedComment></ownedOperation><ownedOperation xmi:id="63a4c6d2147074.79702825" 
            name="smtpConnect" visibility="public" ><ownedParameter xmi:id="63a4c6d21471a9.93168063" name="return" direction="return"><type xmi:idref="63a4c6d209e377.76986812"/></ownedParameter><ownedParameter xmi:id="63a4c6d21471e4.19696167" name="$options" direction="in"><type xmi:idref="63a4c6d209e232.56111258"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21ddd00.19478682" value="null" /></ownedParameter><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21ddd32.20599469" annotatedElement="63a4c6d2147074.79702825"><body>Initiate a connection to an SMTP server.
Returns false if the operation failed.</body></ownedComment></ownedOperation><ownedOperation xmi:id="63a4c6d2148715.19625234" 
            name="smtpClose" visibility="public" ><ownedParameter xmi:id="63a4c6d2148797.60808600" name="return" direction="return"><type xmi:idref="63a4c6d209e429.79234751"/></ownedParameter><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21ddd88.38675122" annotatedElement="63a4c6d2148715.19625234"><body>Close the active SMTP session if one exists.</body></ownedComment></ownedOperation><ownedOperation xmi:id="63a4c6d2148e90.84142649" 
            name="setLanguage" visibility="public" ><ownedParameter xmi:id="63a4c6d2148fa5.99248098" name="return" direction="return"><type xmi:idref="63a4c6d209e377.76986812"/></ownedParameter><ownedParameter xmi:id="63a4c6d2148ff7.93580270" name="$langcode" direction="in"><type xmi:idref="63a4c6d209e2b6.20155476"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21ddde8.47880889" value="&#039;en&#039;" /></ownedParameter><ownedParameter xmi:id="63a4c6d2149048.20997232" name="$lang_path" direction="in"><type xmi:idref="63a4c6d209e2b6.20155476"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21dde04.09802817" value="&#039;&#039;" /></ownedParameter><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21dde33.27614448" annotatedElement="63a4c6d2148e90.84142649"><body>Set the language for error messages.
The default language is English.</body></ownedComment></ownedOperation><ownedOperation xmi:id="63a4c6d214a176.33389938" 
            name="getTranslations" visibility="public" ><ownedParameter xmi:id="63a4c6d214a221.10750376" name="return" direction="return"><type xmi:idref="63a4c6d209e232.56111258"/></ownedParameter><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21dde83.18777913" annotatedElement="63a4c6d214a176.33389938"><body>Get the array of strings for the current language.</body></ownedComment></ownedOperation><ownedOperation xmi:id="63a4c6d214a767.07795691" 
            name="addrAppend" visibility="public" ><ownedParameter xmi:id="63a4c6d214a885.40347480" name="return" direction="return"><type xmi:idref="63a4c6d209e2b6.20155476"/></ownedParameter><ownedParameter xmi:id="63a4c6d214a8b8.18581044" name="$type" direction="in"><type xmi:idref="63a4c6d209e2b6.20155476"/></ownedParameter><ownedParameter xmi:id="63a4c6d214a8f2.65956762" name="$addr" direction="in"><type xmi:idref="63a4c6d209e232.56111258"/></ownedParameter><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21de012.74397717" annotatedElement="63a4c6d214a767.07795691"><body>Create recipient headers.</body></ownedComment></ownedOperation><ownedOperation xmi:id="63a4c6d214ad62.16645880" 
            name="addrFormat" visibility="public" ><ownedParameter xmi:id="63a4c6d214ae30.11333750" name="return" direction="return"><type xmi:idref="63a4c6d209e2b6.20155476"/></ownedParameter><ownedParameter xmi:id="63a4c6d214ae69.59132687" name="$addr" direction="in"><type xmi:idref="63a4c6d209e232.56111258"/></ownedParameter><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21de086.14918581" annotatedElement="63a4c6d214ad62.16645880"><body>Format an address for use in a message header.</body></ownedComment></ownedOperation><ownedOperation xmi:id="63a4c6d214b457.90378291" 
            name="wrapText" visibility="public" ><ownedParameter xmi:id="63a4c6d214b581.97945027" name="return" direction="return"><type xmi:idref="63a4c6d209e2b6.20155476"/></ownedParameter><ownedParameter xmi:id="63a4c6d214b5b7.32770483" name="$message" direction="in"><type xmi:idref="63a4c6d209e2b6.20155476"/></ownedParameter><ownedParameter xmi:id="63a4c6d214b608.41228003" name="$length" direction="in"><type xmi:idref="63a4c6d209e2f2.35908695"/></ownedParameter><ownedParameter xmi:id="63a4c6d214b651.52073911" name="$qp_mode" direction="in"><type xmi:idref="63a4c6d209e377.76986812"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21de111.10986510" value="false" /></ownedParameter><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21de133.65410043" annotatedElement="63a4c6d214b457.90378291"><body>Word-wrap message.
For use with mailers that do not automatically perform wrapping and for quoted-printable encoded messages.
Original written by philippe.</body></ownedComment></ownedOperation><ownedOperation xmi:id="63a4c6d214c9c9.63133190" 
            name="utf8CharBoundary" visibility="public" ><ownedParameter xmi:id="63a4c6d214cae1.75637196" name="return" direction="return"><type xmi:idref="63a4c6d209e2f2.35908695"/></ownedParameter><ownedParameter xmi:id="63a4c6d214cb19.63395168" name="$encodedText" direction="in"><type xmi:idref="63a4c6d209e2b6.20155476"/></ownedParameter><ownedParameter xmi:id="63a4c6d214cb57.12003168" name="$maxLength" direction="in"><type xmi:idref="63a4c6d209e2f2.35908695"/></ownedParameter><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21de1e1.95161357" annotatedElement="63a4c6d214c9c9.63133190"><body>Find the last character boundary prior to $maxLength in a utf-8 quoted-printable encoded string.
Original written by Colin Brown.</body></ownedComment></ownedOperation><ownedOperation xmi:id="63a4c6d214d3c1.43607671" 
            name="setWordWrap" visibility="public" ><ownedParameter xmi:id="63a4c6d214d449.10138739" name="return" direction="return"><type xmi:idref="63a4c6d209e429.79234751"/></ownedParameter><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21de245.68287840" annotatedElement="63a4c6d214d3c1.43607671"><body>Apply word wrapping to the message body.
Wraps the message body to the number of chars set in the WordWrap property.
You should only do this to plain-text bodies as wrapping HTML tags may break them.
This is called automatically by createBody(), so you don't need to call it yourself.</body></ownedComment></ownedOperation><ownedOperation xmi:id="63a4c6d214d7d9.26858372" 
            name="createHeader" visibility="public" ><ownedParameter xmi:id="63a4c6d214d883.06150249" name="return" direction="return"><type xmi:idref="63a4c6d209e2b6.20155476"/></ownedParameter><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21de2c3.85068038" annotatedElement="63a4c6d214d7d9.26858372"><body>Assemble message headers.</body></ownedComment></ownedOperation><ownedOperation xmi:id="63a4c6d214e9d9.21314128" 
            name="getMailMIME" visibility="public" ><ownedParameter xmi:id="63a4c6d214ea76.84701030" name="return" direction="return"><type xmi:idref="63a4c6d209e2b6.20155476"/></ownedParameter><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21de315.54338573" annotatedElement="63a4c6d214e9d9.21314128"><body>Get the message MIME type headers.</body></ownedComment></ownedOperation><ownedOperation xmi:id="63a4c6d2154551.14769421" 
            name="getSentMIMEMessage" visibility="public" ><ownedParameter xmi:id="63a4c6d2154759.35645203" name="return" direction="return"><type xmi:idref="63a4c6d209e2b6.20155476"/></ownedParameter><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21de361.36775299" annotatedElement="63a4c6d2154551.14769421"><body>Returns the whole MIME message.
Includes complete headers and body.
Only valid post preSend().</body></ownedComment></ownedOperation><ownedOperation xmi:id="63a4c6d2154986.66546762" 
            name="generateId" visibility="protected" ><ownedParameter xmi:id="63a4c6d2154a31.63632632" name="return" direction="return"><type xmi:idref="63a4c6d209e2b6.20155476"/></ownedParameter><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21de3c1.46949708" annotatedElement="63a4c6d2154986.66546762"><body>Create a unique ID to use for boundaries.</body></ownedComment></ownedOperation><ownedOperation xmi:id="63a4c6d2154ff1.01690423" 
            name="createBody" visibility="public" ><ownedParameter xmi:id="63a4c6d21550d2.46278869" name="return" direction="return"><type xmi:idref="63a4c6d209e2b6.20155476"/></ownedParameter><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21de414.26505977" annotatedElement="63a4c6d2154ff1.01690423"><body>Assemble the message body.
Returns an empty string on failure.</body></ownedComment></ownedOperation><ownedOperation xmi:id="63a4c6d2158344.27506895" 
            name="getBoundaries" visibility="public" ><ownedParameter xmi:id="63a4c6d21583f7.95880042" name="return" direction="return"><type xmi:idref="63a4c6d209e232.56111258"/></ownedParameter><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21de468.30926305" annotatedElement="63a4c6d2158344.27506895"><body>Get the boundaries that this message will use</body></ownedComment></ownedOperation><ownedOperation xmi:id="63a4c6d2158711.32406098" 
            name="getBoundary" visibility="protected" ><ownedParameter xmi:id="63a4c6d2158855.79446803" name="return" direction="return"><type xmi:idref="63a4c6d209e2b6.20155476"/></ownedParameter><ownedParameter xmi:id="63a4c6d2158892.87798918" name="$boundary" direction="in"><type xmi:idref="63a4c6d209e2b6.20155476"/></ownedParameter><ownedParameter xmi:id="63a4c6d21588f6.75708754" name="$charSet" direction="in"><type xmi:idref="63a4c6d209e2b6.20155476"/></ownedParameter><ownedParameter xmi:id="63a4c6d2158937.40697305" name="$contentType" direction="in"><type xmi:idref="63a4c6d209e2b6.20155476"/></ownedParameter><ownedParameter xmi:id="63a4c6d2158978.38234973" name="$encoding" direction="in"><type xmi:idref="63a4c6d209e2b6.20155476"/></ownedParameter><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21de532.97907833" annotatedElement="63a4c6d2158711.32406098"><body>Return the start of a message boundary.</body></ownedComment></ownedOperation><ownedOperation xmi:id="63a4c6d2158e76.92402244" 
            name="endBoundary" visibility="protected" ><ownedParameter xmi:id="63a4c6d2158f46.42074942" name="return" direction="return"><type xmi:idref="63a4c6d209e2b6.20155476"/></ownedParameter><ownedParameter xmi:id="63a4c6d2158f77.49896591" name="$boundary" direction="in"><type xmi:idref="63a4c6d209e2b6.20155476"/></ownedParameter><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21de5a2.08085443" annotatedElement="63a4c6d2158e76.92402244"><body>Return the end of a message boundary.</body></ownedComment></ownedOperation><ownedOperation xmi:id="63a4c6d21591b6.91412284" 
            name="setMessageType" visibility="protected" ><ownedParameter xmi:id="63a4c6d2159237.86200152" name="return" direction="return"><type xmi:idref="63a4c6d209e429.79234751"/></ownedParameter><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21de5f7.84234072" annotatedElement="63a4c6d21591b6.91412284"><body>Set the message type.
PHPMailer only supports some preset message types, not arbitrary MIME structures.</body></ownedComment></ownedOperation><ownedOperation xmi:id="63a4c6d2159691.34279295" 
            name="headerLine" visibility="public" ><ownedParameter xmi:id="63a4c6d2159781.88423430" name="return" direction="return"><type xmi:idref="63a4c6d209e2b6.20155476"/></ownedParameter><ownedParameter xmi:id="63a4c6d21597a9.78303396" name="$name" direction="in"><type xmi:idref="63a4c6d209e2b6.20155476"/></ownedParameter><ownedParameter xmi:id="63a4c6d21597f9.54639661" name="$value" direction="in"></ownedParameter><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21de687.73576117" annotatedElement="63a4c6d2159691.34279295"><body>Format a header line.</body></ownedComment></ownedOperation><ownedOperation xmi:id="63a4c6d21599f6.16711590" 
            name="textLine" visibility="public" ><ownedParameter xmi:id="63a4c6d2159ac5.84128578" name="return" direction="return"><type xmi:idref="63a4c6d209e2b6.20155476"/></ownedParameter><ownedParameter xmi:id="63a4c6d2159ae9.05066572" name="$value" direction="in"><type xmi:idref="63a4c6d209e2b6.20155476"/></ownedParameter><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21de6f2.55106376" annotatedElement="63a4c6d21599f6.16711590"><body>Return a formatted mail line.</body></ownedComment></ownedOperation><ownedOperation xmi:id="63a4c6d215a273.91725782" 
            name="addAttachment" visibility="public" ><ownedParameter xmi:id="63a4c6d215a430.82545644" name="return" direction="return"><type xmi:idref="63a4c6d209e377.76986812"/></ownedParameter><ownedParameter xmi:id="63a4c6d215a468.94644611" name="$path" direction="in"><type xmi:idref="63a4c6d209e2b6.20155476"/></ownedParameter><ownedParameter xmi:id="63a4c6d215a4c4.97292711" name="$name" direction="in"><type xmi:idref="63a4c6d209e2b6.20155476"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21de762.13120833" value="&#039;&#039;" /></ownedParameter><ownedParameter xmi:id="63a4c6d215a521.01451600" name="$encoding" direction="in"><type xmi:idref="63a4c6d209e2b6.20155476"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21de783.52942899" value="selfENCODING_BASE64" /></ownedParameter><ownedParameter xmi:id="63a4c6d215a577.95208473" name="$type" direction="in"><type xmi:idref="63a4c6d209e2b6.20155476"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21de7a7.49809754" value="&#039;&#039;" /></ownedParameter><ownedParameter xmi:id="63a4c6d215a5d6.79926901" name="$disposition" direction="in"><type xmi:idref="63a4c6d209e2b6.20155476"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21de7d8.58085673" value="&#039;attachment&#039;" /></ownedParameter><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21de806.75763069" annotatedElement="63a4c6d215a273.91725782"><body>Add an attachment from a path on the filesystem.
Never use a user-supplied path to a file! Returns false if the file could not be found or read.
Explicitly *does not* support passing URLs; PHPMailer is not an HTTP client.
If you need to do that, fetch the resource yourself and pass it in via a local file or string.</body></ownedComment></ownedOperation><ownedOperation xmi:id="63a4c6d215ad07.77637981" 
            name="getAttachments" visibility="public" ><ownedParameter xmi:id="63a4c6d215ada5.69011232" name="return" direction="return"><type xmi:idref="63a4c6d209e232.56111258"/></ownedParameter><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21de877.77069019" annotatedElement="63a4c6d215ad07.77637981"><body>Return the array of attachments.</body></ownedComment></ownedOperation><ownedOperation xmi:id="63a4c6d215b0c0.05342392" 
            name="attachAll" visibility="protected" ><ownedParameter xmi:id="63a4c6d215b1e2.42041482" name="return" direction="return"><type xmi:idref="63a4c6d209e2b6.20155476"/></ownedParameter><ownedParameter xmi:id="63a4c6d215b201.88179753" name="$disposition_type" direction="in"><type xmi:idref="63a4c6d209e2b6.20155476"/></ownedParameter><ownedParameter xmi:id="63a4c6d215b255.01177643" name="$boundary" direction="in"><type xmi:idref="63a4c6d209e2b6.20155476"/></ownedParameter><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21de913.32474636" annotatedElement="63a4c6d215b0c0.05342392"><body>Attach all file, string, and binary attachments to the message.
Returns an empty string on failure.</body></ownedComment></ownedOperation><ownedOperation xmi:id="63a4c6d215c491.79476748" 
            name="encodeFile" visibility="protected" ><ownedParameter xmi:id="63a4c6d215c5a1.54482738" name="return" direction="return"><type xmi:idref="63a4c6d209e2b6.20155476"/></ownedParameter><ownedParameter xmi:id="63a4c6d215c5c6.62884577" name="$path" direction="in"><type xmi:idref="63a4c6d209e2b6.20155476"/></ownedParameter><ownedParameter xmi:id="63a4c6d215c638.46251723" name="$encoding" direction="in"><type xmi:idref="63a4c6d209e2b6.20155476"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21de990.14562794" value="selfENCODING_BASE64" /></ownedParameter><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21de9b6.23457826" annotatedElement="63a4c6d215c491.79476748"><body>Encode a file attachment in requested format.
Returns an empty string on failure.</body></ownedComment></ownedOperation><ownedOperation xmi:id="63a4c6d215cd55.34805227" 
            name="encodeString" visibility="public" ><ownedParameter xmi:id="63a4c6d215ce65.80367907" name="return" direction="return"><type xmi:idref="63a4c6d209e2b6.20155476"/></ownedParameter><ownedParameter xmi:id="63a4c6d215ce97.68229463" name="$str" direction="in"><type xmi:idref="63a4c6d209e2b6.20155476"/></ownedParameter><ownedParameter xmi:id="63a4c6d215cf06.81510085" name="$encoding" direction="in"><type xmi:idref="63a4c6d209e2b6.20155476"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21dea37.99673907" value="selfENCODING_BASE64" /></ownedParameter><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21dea68.52137958" annotatedElement="63a4c6d215cd55.34805227"><body>Encode a string in requested format.
Returns an empty string on failure.</body></ownedComment></ownedOperation><ownedOperation xmi:id="63a4c6d215d789.42004816" 
            name="encodeHeader" visibility="public" ><ownedParameter xmi:id="63a4c6d215d953.15728038" name="return" direction="return"><type xmi:idref="63a4c6d209e2b6.20155476"/></ownedParameter><ownedParameter xmi:id="63a4c6d215d989.60050342" name="$str" direction="in"><type xmi:idref="63a4c6d209e2b6.20155476"/></ownedParameter><ownedParameter xmi:id="63a4c6d215d9e0.53181931" name="$position" direction="in"><type xmi:idref="63a4c6d209e2b6.20155476"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21dead4.86130646" value="&#039;text&#039;" /></ownedParameter><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21deaf0.13034922" annotatedElement="63a4c6d215d789.42004816"><body>Encode a header value (not including its label) optimally.
Picks shortest of Q, B, or none. Result includes folding if needed.
See RFC822 definitions for phrase, comment and text positions.</body></ownedComment></ownedOperation><ownedOperation xmi:id="63a4c6d215e8b3.81165100" 
            name="hasMultiBytes" visibility="public" ><ownedParameter xmi:id="63a4c6d215e987.44122385" name="return" direction="return"><type xmi:idref="63a4c6d209e377.76986812"/></ownedParameter><ownedParameter xmi:id="63a4c6d215e9b7.13381855" name="$str" direction="in"><type xmi:idref="63a4c6d209e2b6.20155476"/></ownedParameter><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21deb86.31402605" annotatedElement="63a4c6d215e8b3.81165100"><body>Check if a string contains multi-byte characters.</body></ownedComment></ownedOperation><ownedOperation xmi:id="63a4c6d215ec95.98799981" 
            name="has8bitChars" visibility="public" ><ownedParameter xmi:id="63a4c6d215ed62.00966882" name="return" direction="return"><type xmi:idref="63a4c6d209e377.76986812"/></ownedParameter><ownedParameter xmi:id="63a4c6d215ed93.78575098" name="$text" direction="in"><type xmi:idref="63a4c6d209e2b6.20155476"/></ownedParameter><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21dec01.87395476" annotatedElement="63a4c6d215ec95.98799981"><body>Does a string contain any 8-bit chars (in any charset)?</body></ownedComment></ownedOperation><ownedOperation xmi:id="63a4c6d215f225.96595697" 
            name="base64EncodeWrapMB" visibility="public" ><ownedParameter xmi:id="63a4c6d215f3d3.76464154" name="return" direction="return"><type xmi:idref="63a4c6d209e2b6.20155476"/></ownedParameter><ownedParameter xmi:id="63a4c6d215f408.16194833" name="$str" direction="in"><type xmi:idref="63a4c6d209e2b6.20155476"/></ownedParameter><ownedParameter xmi:id="63a4c6d215f464.31307144" name="$linebreak" direction="in"><type xmi:idref="63a4c6d209e2b6.20155476"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21dec93.17121729" value="null" /></ownedParameter><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21decb7.08340740" annotatedElement="63a4c6d215f225.96595697"><body>Encode and wrap long multibyte strings for mail headers without breaking lines within a character.
Adapted from a function by paravoid.</body></ownedComment></ownedOperation><ownedOperation xmi:id="63a4c6d215fc57.30921966" 
            name="encodeQP" visibility="public" ><ownedParameter xmi:id="63a4c6d215fd52.28232198" name="return" direction="return"><type xmi:idref="63a4c6d209e2b6.20155476"/></ownedParameter><ownedParameter xmi:id="63a4c6d215fd77.45877016" name="$string" direction="in"><type xmi:idref="63a4c6d209e2b6.20155476"/></ownedParameter><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21ded33.03654636" annotatedElement="63a4c6d215fc57.30921966"><body>Encode a string in quoted-printable format.
According to RFC2045 section 6.7.</body></ownedComment></ownedOperation><ownedOperation xmi:id="63a4c6d2160111.61550778" 
            name="encodeQ" visibility="public" ><ownedParameter xmi:id="63a4c6d2160231.08225353" name="return" direction="return"><type xmi:idref="63a4c6d209e2b6.20155476"/></ownedParameter><ownedParameter xmi:id="63a4c6d2160263.59644098" name="$str" direction="in"><type xmi:idref="63a4c6d209e2b6.20155476"/></ownedParameter><ownedParameter xmi:id="63a4c6d21602c4.53792539" name="$position" direction="in"><type xmi:idref="63a4c6d209e2b6.20155476"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21dedb8.89490137" value="&#039;text&#039;" /></ownedParameter><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21dedd5.68429933" annotatedElement="63a4c6d2160111.61550778"><body>Encode a string using Q encoding.</body></ownedComment></ownedOperation><ownedOperation xmi:id="63a4c6d2160e04.44637679" 
            name="addStringAttachment" visibility="public" ><ownedParameter xmi:id="63a4c6d2160fb3.90315721" name="return" direction="return"><type xmi:idref="63a4c6d209e377.76986812"/></ownedParameter><ownedParameter xmi:id="63a4c6d2160fe7.69510012" name="$string" direction="in"><type xmi:idref="63a4c6d209e2b6.20155476"/></ownedParameter><ownedParameter xmi:id="63a4c6d2161032.20268581" name="$filename" direction="in"><type xmi:idref="63a4c6d209e2b6.20155476"/></ownedParameter><ownedParameter xmi:id="63a4c6d2161097.63240468" name="$encoding" direction="in"><type xmi:idref="63a4c6d209e2b6.20155476"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21dee62.53736525" value="selfENCODING_BASE64" /></ownedParameter><ownedParameter xmi:id="63a4c6d21610e4.01504442" name="$type" direction="in"><type xmi:idref="63a4c6d209e2b6.20155476"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21dee97.51916173" value="&#039;&#039;" /></ownedParameter><ownedParameter xmi:id="63a4c6d2161149.37308795" name="$disposition" direction="in"><type xmi:idref="63a4c6d209e2b6.20155476"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21deeb7.26510587" value="&#039;attachment&#039;" /></ownedParameter><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21deee4.92623869" annotatedElement="63a4c6d2160e04.44637679"><body>Add a string or binary attachment (non-filesystem).
This method can be used to attach ascii or binary data, such as a BLOB record from a database.</body></ownedComment></ownedOperation><ownedOperation xmi:id="63a4c6d2162165.24591977" 
            name="addEmbeddedImage" visibility="public" ><ownedParameter xmi:id="63a4c6d2162376.30684474" name="return" direction="return"><type xmi:idref="63a4c6d209e377.76986812"/></ownedParameter><ownedParameter xmi:id="63a4c6d21623a2.02856573" name="$path" direction="in"><type xmi:idref="63a4c6d209e2b6.20155476"/></ownedParameter><ownedParameter xmi:id="63a4c6d21623f5.47950677" name="$cid" direction="in"><type xmi:idref="63a4c6d209e2b6.20155476"/></ownedParameter><ownedParameter xmi:id="63a4c6d2162445.04795229" name="$name" direction="in"><type xmi:idref="63a4c6d209e2b6.20155476"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21def83.01546515" value="&#039;&#039;" /></ownedParameter><ownedParameter xmi:id="63a4c6d2162495.10176097" name="$encoding" direction="in"><type xmi:idref="63a4c6d209e2b6.20155476"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21defa7.98765344" value="selfENCODING_BASE64" /></ownedParameter><ownedParameter xmi:id="63a4c6d21624f7.61103511" name="$type" direction="in"><type xmi:idref="63a4c6d209e2b6.20155476"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21defd3.31442745" value="&#039;&#039;" /></ownedParameter><ownedParameter xmi:id="63a4c6d2162550.72275194" name="$disposition" direction="in"><type xmi:idref="63a4c6d209e2b6.20155476"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21deff8.67699433" value="&#039;inline&#039;" /></ownedParameter><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21df021.07727310" annotatedElement="63a4c6d2162165.24591977"><body>Add an embedded (inline) attachment from a file.
This can include images, sounds, and just about any other document type.
These differ from 'regular' attachments in that they are intended to be displayed inline with the message, not just attached for download.
This is used in HTML messages that embed the images the HTML refers to using the `$cid` value in `img` tags, for example `&lt;img src=&quot;cid:mylogo&quot;&gt;`.
Never use a user-supplied path to a file!</body></ownedComment></ownedOperation><ownedOperation xmi:id="63a4c6d21635b0.99819642" 
            name="addStringEmbeddedImage" visibility="public" ><ownedParameter xmi:id="63a4c6d21637b8.32100140" name="return" direction="return"><type xmi:idref="63a4c6d209e377.76986812"/></ownedParameter><ownedParameter xmi:id="63a4c6d21637e3.98820361" name="$string" direction="in"><type xmi:idref="63a4c6d209e2b6.20155476"/></ownedParameter><ownedParameter xmi:id="63a4c6d2163836.49330101" name="$cid" direction="in"><type xmi:idref="63a4c6d209e2b6.20155476"/></ownedParameter><ownedParameter xmi:id="63a4c6d2163893.95756490" name="$name" direction="in"><type xmi:idref="63a4c6d209e2b6.20155476"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21df0e2.53783705" value="&#039;&#039;" /></ownedParameter><ownedParameter xmi:id="63a4c6d21638e8.27209705" name="$encoding" direction="in"><type xmi:idref="63a4c6d209e2b6.20155476"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21df119.64024252" value="selfENCODING_BASE64" /></ownedParameter><ownedParameter xmi:id="63a4c6d2163966.87405115" name="$type" direction="in"><type xmi:idref="63a4c6d209e2b6.20155476"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21df138.47779115" value="&#039;&#039;" /></ownedParameter><ownedParameter xmi:id="63a4c6d21639b8.67337101" name="$disposition" direction="in"><type xmi:idref="63a4c6d209e2b6.20155476"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21df165.53267978" value="&#039;inline&#039;" /></ownedParameter><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21df180.57070577" annotatedElement="63a4c6d21635b0.99819642"><body>Add an embedded stringified attachment.
This can include images, sounds, and just about any other document type.
If your filename doesn't contain an extension, be sure to set the $type to an appropriate MIME type.</body></ownedComment></ownedOperation><ownedOperation xmi:id="63a4c6d2163fc1.13526199" 
            name="validateEncoding" visibility="protected" ><ownedParameter xmi:id="63a4c6d2164092.81062219" name="return" direction="return"><type xmi:idref="63a4c6d209e377.76986812"/></ownedParameter><ownedParameter xmi:id="63a4c6d21640c5.37018902" name="$encoding" direction="in"><type xmi:idref="63a4c6d209e2b6.20155476"/></ownedParameter><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21df210.10970808" annotatedElement="63a4c6d2163fc1.13526199"><body>Validate encodings.</body></ownedComment></ownedOperation><ownedOperation xmi:id="63a4c6d2164395.57814105" 
            name="cidExists" visibility="protected" ><ownedParameter xmi:id="63a4c6d2164451.80146142" name="return" direction="return"><type xmi:idref="63a4c6d209e377.76986812"/></ownedParameter><ownedParameter xmi:id="63a4c6d2164483.71592502" name="$cid" direction="in"><type xmi:idref="63a4c6d209e2b6.20155476"/></ownedParameter><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21df289.15778511" annotatedElement="63a4c6d2164395.57814105"><body>Check if an embedded attachment is present with this cid.</body></ownedComment></ownedOperation><ownedOperation xmi:id="63a4c6d2164715.38832026" 
            name="inlineImageExists" visibility="public" ><ownedParameter xmi:id="63a4c6d21647b3.39381467" name="return" direction="return"><type xmi:idref="63a4c6d209e377.76986812"/></ownedParameter><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21df2d5.69613270" annotatedElement="63a4c6d2164715.38832026"><body>Check if an inline attachment is present.</body></ownedComment></ownedOperation><ownedOperation xmi:id="63a4c6d2164a23.72446653" 
            name="attachmentExists" visibility="public" ><ownedParameter xmi:id="63a4c6d2164ac4.86122858" name="return" direction="return"><type xmi:idref="63a4c6d209e377.76986812"/></ownedParameter><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21df329.74126275" annotatedElement="63a4c6d2164a23.72446653"><body>Check if an attachment (non-inline) is present.</body></ownedComment></ownedOperation><ownedOperation xmi:id="63a4c6d2164d16.86552056" 
            name="alternativeExists" visibility="public" ><ownedParameter xmi:id="63a4c6d2164db3.36954160" name="return" direction="return"><type xmi:idref="63a4c6d209e377.76986812"/></ownedParameter><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21df377.89160412" annotatedElement="63a4c6d2164d16.86552056"><body>Check if this message has an alternative body set.</body></ownedComment></ownedOperation><ownedOperation xmi:id="63a4c6d2164f99.15151253" 
            name="clearQueuedAddresses" visibility="public" ><ownedParameter xmi:id="63a4c6d2165038.94025345" name="return" direction="return"><type xmi:idref="63a4c6d209e429.79234751"/></ownedParameter><ownedParameter xmi:id="63a4c6d2165061.85025813" name="$kind" direction="in"><type xmi:idref="63a4c6d209e2b6.20155476"/></ownedParameter><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21df3f1.55072243" annotatedElement="63a4c6d2164f99.15151253"><body>Clear queued addresses of given kind.</body></ownedComment></ownedOperation><ownedOperation xmi:id="63a4c6d21653a6.25797301" 
            name="clearAddresses" visibility="public" ><ownedParameter xmi:id="63a4c6d2165410.50280660" name="return" direction="return"><type xmi:idref="63a4c6d209e429.79234751"/></ownedParameter><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21df443.92228940" annotatedElement="63a4c6d21653a6.25797301"><body>Clear all To recipients.</body></ownedComment></ownedOperation><ownedOperation xmi:id="63a4c6d2165638.83677699" 
            name="clearCCs" visibility="public" ><ownedParameter xmi:id="63a4c6d21656a6.07388593" name="return" direction="return"><type xmi:idref="63a4c6d209e429.79234751"/></ownedParameter><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21df498.50212071" annotatedElement="63a4c6d2165638.83677699"><body>Clear all CC recipients.</body></ownedComment></ownedOperation><ownedOperation xmi:id="63a4c6d21658c3.71878799" 
            name="clearBCCs" visibility="public" ><ownedParameter xmi:id="63a4c6d2165931.68080580" name="return" direction="return"><type xmi:idref="63a4c6d209e429.79234751"/></ownedParameter><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21df4d8.10256412" annotatedElement="63a4c6d21658c3.71878799"><body>Clear all BCC recipients.</body></ownedComment></ownedOperation><ownedOperation xmi:id="63a4c6d2165b68.80314413" 
            name="clearReplyTos" visibility="public" ><ownedParameter xmi:id="63a4c6d2165bd6.13510472" name="return" direction="return"><type xmi:idref="63a4c6d209e429.79234751"/></ownedParameter><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21df529.05866503" annotatedElement="63a4c6d2165b68.80314413"><body>Clear all ReplyTo recipients.</body></ownedComment></ownedOperation><ownedOperation xmi:id="63a4c6d2165d42.46360420" 
            name="clearAllRecipients" visibility="public" ><ownedParameter xmi:id="63a4c6d2165da9.85203056" name="return" direction="return"><type xmi:idref="63a4c6d209e429.79234751"/></ownedParameter><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21df574.62222319" annotatedElement="63a4c6d2165d42.46360420"><body>Clear all recipient types.</body></ownedComment></ownedOperation><ownedOperation xmi:id="63a4c6d2165ff3.14945452" 
            name="clearAttachments" visibility="public" ><ownedParameter xmi:id="63a4c6d2166082.03567997" name="return" direction="return"><type xmi:idref="63a4c6d209e429.79234751"/></ownedParameter><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21df5c0.10512580" annotatedElement="63a4c6d2165ff3.14945452"><body>Clear all filesystem, string, and binary attachments.</body></ownedComment></ownedOperation><ownedOperation xmi:id="63a4c6d21661b7.21119995" 
            name="clearCustomHeaders" visibility="public" ><ownedParameter xmi:id="63a4c6d2166231.56892927" name="return" direction="return"><type xmi:idref="63a4c6d209e429.79234751"/></ownedParameter><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21df615.79825154" annotatedElement="63a4c6d21661b7.21119995"><body>Clear all custom headers.</body></ownedComment></ownedOperation><ownedOperation xmi:id="63a4c6d21663f4.77010461" 
            name="setError" visibility="protected" ><ownedParameter xmi:id="63a4c6d21664c1.57897721" name="return" direction="return"><type xmi:idref="63a4c6d209e429.79234751"/></ownedParameter><ownedParameter xmi:id="63a4c6d21664e7.67469160" name="$msg" direction="in"><type xmi:idref="63a4c6d209e2b6.20155476"/></ownedParameter><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21df680.84517761" annotatedElement="63a4c6d21663f4.77010461"><body>Add an error message to the error container.</body></ownedComment></ownedOperation><ownedOperation xmi:id="63a4c6d2166b54.70474990" 
            name="rfcDate" visibility="public"  isStatic="true"><ownedParameter xmi:id="63a4c6d2166c15.36169342" name="return" direction="return"><type xmi:idref="63a4c6d209e2b6.20155476"/></ownedParameter><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21df6d0.80207771" annotatedElement="63a4c6d2166b54.70474990"><body>Return an RFC 822 formatted date.</body></ownedComment></ownedOperation><ownedOperation xmi:id="63a4c6d2166e52.94548196" 
            name="serverHostname" visibility="protected" ><ownedParameter xmi:id="63a4c6d2166f11.09298170" name="return" direction="return"><type xmi:idref="63a4c6d209e2b6.20155476"/></ownedParameter><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21df722.12544255" annotatedElement="63a4c6d2166e52.94548196"><body>Get the server hostname.
Returns 'localhost.localdomain' if unknown.</body></ownedComment></ownedOperation><ownedOperation xmi:id="63a4c6d2167690.47362461" 
            name="isValidHost" visibility="public"  isStatic="true"><ownedParameter xmi:id="63a4c6d2167771.77022865" name="return" direction="return"><type xmi:idref="63a4c6d209e377.76986812"/></ownedParameter><ownedParameter xmi:id="63a4c6d2167797.08651426" name="$host" direction="in"><type xmi:idref="63a4c6d209e2b6.20155476"/></ownedParameter><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21df790.92587789" annotatedElement="63a4c6d2167690.47362461"><body>Validate whether a string contains a valid value to use as a hostname or IP address.
IPv6 addresses must include [], e.g. `[::1]`, not just `::1`.</body></ownedComment></ownedOperation><ownedOperation xmi:id="63a4c6d2167db5.83756024" 
            name="lang" visibility="protected" ><ownedParameter xmi:id="63a4c6d2167e83.74665323" name="return" direction="return"><type xmi:idref="63a4c6d209e2b6.20155476"/></ownedParameter><ownedParameter xmi:id="63a4c6d2167ea9.41169089" name="$key" direction="in"><type xmi:idref="63a4c6d209e2b6.20155476"/></ownedParameter><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21df811.56570041" annotatedElement="63a4c6d2167db5.83756024"><body>Get an error message in the current language.</body></ownedComment></ownedOperation><ownedOperation xmi:id="63a4c6d21682b4.80492233" 
            name="getSmtpErrorMessage" visibility="private" ><ownedParameter xmi:id="63a4c6d21683b3.37405935" name="return" direction="return"><type xmi:idref="63a4c6d209e2b6.20155476"/></ownedParameter><ownedParameter xmi:id="63a4c6d21683e6.99600867" name="$base_key" direction="in"><type xmi:idref="63a4c6d209e2b6.20155476"/></ownedParameter><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21df895.96278322" annotatedElement="63a4c6d21682b4.80492233"><body>Build an error message starting with a generic one and adding details if possible.</body></ownedComment></ownedOperation><ownedOperation xmi:id="63a4c6d2168779.66700760" 
            name="isError" visibility="public" ><ownedParameter xmi:id="63a4c6d2168871.85950390" name="return" direction="return"><type xmi:idref="63a4c6d209e377.76986812"/></ownedParameter><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21df8e6.00687760" annotatedElement="63a4c6d2168779.66700760"><body>Check if an error occurred.</body></ownedComment></ownedOperation><ownedOperation xmi:id="63a4c6d2168c11.52592504" 
            name="addCustomHeader" visibility="public" ><ownedParameter xmi:id="63a4c6d2168d43.56926099" name="return" direction="return"><type xmi:idref="63a4c6d209e377.76986812"/></ownedParameter><ownedParameter xmi:id="63a4c6d2168d61.16054688" name="$name" direction="in"><type xmi:idref="63a4c6d209e2b6.20155476"/></ownedParameter><ownedParameter xmi:id="63a4c6d2168dc8.38151165" name="$value" direction="in"><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21df954.67768445" value="null" /></ownedParameter><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21df978.21361501" annotatedElement="63a4c6d2168c11.52592504"><body>Add a custom header.
$name value can be overloaded to contain both header name and value (name:value).</body></ownedComment></ownedOperation><ownedOperation xmi:id="63a4c6d21692e7.59984626" 
            name="getCustomHeaders" visibility="public" ><ownedParameter xmi:id="63a4c6d2169386.44250733" name="return" direction="return"><type xmi:idref="63a4c6d209e232.56111258"/></ownedParameter><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21df9d7.62283065" annotatedElement="63a4c6d21692e7.59984626"><body>Returns all custom headers.</body></ownedComment></ownedOperation><ownedOperation xmi:id="63a4c6d2169e89.30896445" 
            name="msgHTML" visibility="public" ><ownedParameter xmi:id="63a4c6d216a058.55974595" name="return" direction="return"><type xmi:idref="63a4c6d209e2b6.20155476"/></ownedParameter><ownedParameter xmi:id="63a4c6d216a086.57634083" name="$message" direction="in"><type xmi:idref="63a4c6d209e2b6.20155476"/></ownedParameter><ownedParameter xmi:id="63a4c6d216a0e3.38901532" name="$basedir" direction="in"><type xmi:idref="63a4c6d209e2b6.20155476"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21dfa41.21335898" value="&#039;&#039;" /></ownedParameter><ownedParameter xmi:id="63a4c6d216a133.65340103" name="$advanced" direction="in"><type xmi:idref="63a4c6d209e377.76986812"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21dfa62.08265523" value="false" /></ownedParameter><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21dfa95.15047037" annotatedElement="63a4c6d2169e89.30896445"><body>Create a message body from an HTML string.
Automatically inlines images and creates a plain-text version by converting the HTML, overwriting any existing values in Body and AltBody.
Do not source $message content from user input! $basedir is prepended when handling relative URLs, e.g. &lt;img src=&quot;/images/a.png&quot;&gt; and must not be empty will look for an image file in $basedir/images/a.png and convert it to inline.
If you don't provide a $basedir, relative paths will be left untouched (and thus probably break in email) Converts data-uri images into embedded attachments.
If you don't want to apply these transformations to your HTML, just set Body and AltBody directly.</body></ownedComment></ownedOperation><ownedOperation xmi:id="63a4c6d216b979.96574808" 
            name="html2text" visibility="public" ><ownedParameter xmi:id="63a4c6d216bb03.54242100" name="return" direction="return"><type xmi:idref="63a4c6d209e2b6.20155476"/></ownedParameter><ownedParameter xmi:id="63a4c6d216bb34.06435991" name="$html" direction="in"><type xmi:idref="63a4c6d209e2b6.20155476"/></ownedParameter><ownedParameter xmi:id="63a4c6d216bb95.10079036" name="$advanced" direction="in"><type xmi:idref="63a4c6d209e377.76986812"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21dfb87.35134827" value="false" /></ownedParameter><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21dfba5.20049621" annotatedElement="63a4c6d216b979.96574808"><body>Convert an HTML string into plain text.
This is used by msgHTML().
Note - older versions of this function used a bundled advanced converter which was removed for license reasons in #232.
Example usage:

```php //Use default conversion $plain = $mail-&gt;html2text($html); //Use your own custom converter $plain = $mail-&gt;html2text($html, function($html) { $converter = new MyHtml2text($html); return $converter-&gt;get_text(); }); ```</body></ownedComment></ownedOperation><ownedOperation xmi:id="63a4c6d216bfa3.72481712" 
            name="_mime_types" visibility="public"  isStatic="true"><ownedParameter xmi:id="63a4c6d216c078.71530170" name="return" direction="return"><type xmi:idref="63a4c6d209e2b6.20155476"/></ownedParameter><ownedParameter xmi:id="63a4c6d216c0b9.62063757" name="$ext" direction="in"><type xmi:idref="63a4c6d209e2b6.20155476"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21dfc31.08341447" value="&#039;&#039;" /></ownedParameter><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21dfc63.99562662" annotatedElement="63a4c6d216bfa3.72481712"><body>Get the MIME type for a file extension.</body></ownedComment></ownedOperation><ownedOperation xmi:id="63a4c6d216d444.85768085" 
            name="filenameToType" visibility="public"  isStatic="true"><ownedParameter xmi:id="63a4c6d216d528.60003594" name="return" direction="return"><type xmi:idref="63a4c6d209e2b6.20155476"/></ownedParameter><ownedParameter xmi:id="63a4c6d216d558.29914738" name="$filename" direction="in"><type xmi:idref="63a4c6d209e2b6.20155476"/></ownedParameter><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21dfcd5.22284977" annotatedElement="63a4c6d216d444.85768085"><body>Map a file name to a MIME type.
Defaults to 'application/octet-stream', i.e.. arbitrary binary data.</body></ownedComment></ownedOperation><ownedOperation xmi:id="63a4c6d216ddf7.29430011" 
            name="mb_pathinfo" visibility="public"  isStatic="true"><ownedParameter xmi:id="63a4c6d216df26.34447717" name="return" direction="return"></ownedParameter><ownedParameter xmi:id="63a4c6d216df57.66341604" name="$path" direction="in"><type xmi:idref="63a4c6d209e2b6.20155476"/></ownedParameter><ownedParameter xmi:id="63a4c6d216dfa9.81660936" name="$options" direction="in"><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21dfd51.66403024" value="null" /></ownedParameter><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21dfd73.68717105" annotatedElement="63a4c6d216ddf7.29430011"><body>Multi-byte-safe pathinfo replacement.
Drop-in replacement for pathinfo(), but multibyte- and cross-platform-safe.</body></ownedComment></ownedOperation><ownedOperation xmi:id="63a4c6d216ea71.97014216" 
            name="set" visibility="public" ><ownedParameter xmi:id="63a4c6d216ebb8.14036618" name="return" direction="return"><type xmi:idref="63a4c6d209e377.76986812"/></ownedParameter><ownedParameter xmi:id="63a4c6d216ebd2.16868006" name="$name" direction="in"><type xmi:idref="63a4c6d209e2b6.20155476"/></ownedParameter><ownedParameter xmi:id="63a4c6d216ec38.97303207" name="$value" direction="in"><type xmi:idref="63a4c6d209e2b6.20155476"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21dfdf2.09169307" value="&#039;&#039;" /></ownedParameter><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21dfe19.15631823" annotatedElement="63a4c6d216ea71.97014216"><body>Set or reset instance properties.
You should avoid this function - it's more verbose, less efficient, more error-prone and harder to debug than setting properties directly.
Usage Example:
`$mail-&gt;set('SMTPSecure', static::ENCRYPTION_STARTTLS);` is the same as:
`$mail-&gt;SMTPSecure = static::ENCRYPTION_STARTTLS;`.</body></ownedComment></ownedOperation><ownedOperation xmi:id="63a4c6d216ef23.62120768" 
            name="secureHeader" visibility="public" ><ownedParameter xmi:id="63a4c6d216eff1.04823634" name="return" direction="return"><type xmi:idref="63a4c6d209e2b6.20155476"/></ownedParameter><ownedParameter xmi:id="63a4c6d216f012.04217076" name="$str" direction="in"><type xmi:idref="63a4c6d209e2b6.20155476"/></ownedParameter><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21dfeb9.21128856" annotatedElement="63a4c6d216ef23.62120768"><body>Strip newlines to prevent header injection.</body></ownedComment></ownedOperation><ownedOperation xmi:id="63a4c6d216f638.97541262" 
            name="normalizeBreaks" visibility="public"  isStatic="true"><ownedParameter xmi:id="63a4c6d216f730.27377023" name="return" direction="return"><type xmi:idref="63a4c6d209e2b6.20155476"/></ownedParameter><ownedParameter xmi:id="63a4c6d216f762.22932441" name="$text" direction="in"><type xmi:idref="63a4c6d209e2b6.20155476"/></ownedParameter><ownedParameter xmi:id="63a4c6d216f7c4.58210903" name="$breaktype" direction="in"><type xmi:idref="63a4c6d209e2b6.20155476"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21dff20.34600340" value="null" /></ownedParameter><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21dff56.72224729" annotatedElement="63a4c6d216f638.97541262"><body>Normalize line breaks in a string.
Converts UNIX LF, Mac CR and Windows CRLF line breaks into a single line break format.
Defaults to CRLF (for message bodies) and preserves consecutive breaks.</body></ownedComment></ownedOperation><ownedOperation xmi:id="63a4c6d216fc66.39285431" 
            name="stripTrailingWSP" visibility="public"  isStatic="true"><ownedParameter xmi:id="63a4c6d216fd32.29184447" name="return" direction="return"><type xmi:idref="63a4c6d209e2b6.20155476"/></ownedParameter><ownedParameter xmi:id="63a4c6d216fd53.34347596" name="$text" direction="in"><type xmi:idref="63a4c6d209e2b6.20155476"/></ownedParameter><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21dffd8.74833061" annotatedElement="63a4c6d216fc66.39285431"><body>Remove trailing whitespace from a string.</body></ownedComment></ownedOperation><ownedOperation xmi:id="63a4c6d2170062.45108425" 
