            name="popBeforeSmtp" visibility="public"  isStatic="true"><ownedParameter xmi:id="63a4c6d217e8e5.68696838" name="return" direction="return"><type xmi:idref="63a4c6d209e377.76986812"/></ownedParameter><ownedParameter xmi:id="63a4c6d217e928.79538960" name="$host" direction="in"><type xmi:idref="63a4c6d209e2b6.20155476"/></ownedParameter><ownedParameter xmi:id="63a4c6d217e998.85108016" name="$port" direction="in"><type xmi:idref="63a4c6d209e377.76986812"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21e1061.59517304" value="false" /></ownedParameter><ownedParameter xmi:id="63a4c6d217e9f2.64016558" name="$timeout" direction="in"><type xmi:idref="63a4c6d209e377.76986812"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21e1091.66880994" value="false" /></ownedParameter><ownedParameter xmi:id="63a4c6d217ea56.20457345" name="$username" direction="in"><type xmi:idref="63a4c6d209e2b6.20155476"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21e10b4.20173232" value="&#039;&#039;" /></ownedParameter><ownedParameter xmi:id="63a4c6d217eaa5.76886464" name="$password" direction="in"><type xmi:idref="63a4c6d209e2b6.20155476"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21e10e2.39056372" value="&#039;&#039;" /></ownedParameter><ownedParameter xmi:id="63a4c6d217eaf1.22252824" name="$debug_level" direction="in"><type xmi:idref="63a4c6d209e2f2.35908695"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21e1107.26905944" value="0" /></ownedParameter><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21e1121.75979451" annotatedElement="63a4c6d217e732.68037046"><body>Simple static wrapper for all-in-one POP before SMTP.</body></ownedComment></ownedOperation><ownedOperation xmi:id="63a4c6d217f087.65822697" 
            name="authorise" visibility="public" ><ownedParameter xmi:id="63a4c6d217f228.45022684" name="return" direction="return"><type xmi:idref="63a4c6d209e377.76986812"/></ownedParameter><ownedParameter xmi:id="63a4c6d217f254.97952998" name="$host" direction="in"><type xmi:idref="63a4c6d209e2b6.20155476"/></ownedParameter><ownedParameter xmi:id="63a4c6d217f2b1.62684725" name="$port" direction="in"><type xmi:idref="63a4c6d209e377.76986812"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21e11a5.71451072" value="false" /></ownedParameter><ownedParameter xmi:id="63a4c6d217f315.22309139" name="$timeout" direction="in"><type xmi:idref="63a4c6d209e377.76986812"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21e11c9.43207920" value="false" /></ownedParameter><ownedParameter xmi:id="63a4c6d217f369.87975140" name="$username" direction="in"><type xmi:idref="63a4c6d209e2b6.20155476"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21e11e3.27226168" value="&#039;&#039;" /></ownedParameter><ownedParameter xmi:id="63a4c6d217f3b7.59401345" name="$password" direction="in"><type xmi:idref="63a4c6d209e2b6.20155476"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21e1213.11552836" value="&#039;&#039;" /></ownedParameter><ownedParameter xmi:id="63a4c6d217f402.66872349" name="$debug_level" direction="in"><type xmi:idref="63a4c6d209e2f2.35908695"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21e1237.01407768" value="0" /></ownedParameter><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21e1267.03945937" annotatedElement="63a4c6d217f087.65822697"><body>Authenticate with a POP3 server.
A connect, login, disconnect sequence appropriate for POP-before SMTP authorisation.</body></ownedComment></ownedOperation><ownedOperation xmi:id="63a4c6d217faa0.19789532" 
            name="connect" visibility="public" ><ownedParameter xmi:id="63a4c6d217fbc8.35028832" name="return" direction="return"><type xmi:idref="63a4c6d209e377.76986812"/></ownedParameter><ownedParameter xmi:id="63a4c6d217fbf2.97365465" name="$host" direction="in"><type xmi:idref="63a4c6d209e2b6.20155476"/></ownedParameter><ownedParameter xmi:id="63a4c6d217fc55.73830708" name="$port" direction="in"><type xmi:idref="63a4c6d209e377.76986812"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21e12d4.44787645" value="false" /></ownedParameter><ownedParameter xmi:id="63a4c6d217fca2.23118949" name="$tval" direction="in"><type xmi:idref="63a4c6d209e2f2.35908695"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21e1303.22827909" value="30" /></ownedParameter><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21e1321.01336314" annotatedElement="63a4c6d217faa0.19789532"><body>Connect to a POP3 server.</body></ownedComment></ownedOperation><ownedOperation xmi:id="63a4c6d2180399.94227335" 
            name="login" visibility="public" ><ownedParameter xmi:id="63a4c6d21804a2.53803823" name="return" direction="return"><type xmi:idref="63a4c6d209e377.76986812"/></ownedParameter><ownedParameter xmi:id="63a4c6d21804e7.32494844" name="$username" direction="in"><type xmi:idref="63a4c6d209e2b6.20155476"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21e1373.10938486" value="&#039;&#039;" /></ownedParameter><ownedParameter xmi:id="63a4c6d2180532.92968259" name="$password" direction="in"><type xmi:idref="63a4c6d209e2b6.20155476"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21e13a0.83341933" value="&#039;&#039;" /></ownedParameter><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21e13c8.00770007" annotatedElement="63a4c6d2180399.94227335"><body>Log in to the POP3 server.
Does not support APOP (RFC 2828, 4949).</body></ownedComment></ownedOperation><ownedOperation xmi:id="63a4c6d2180a19.94005564" 
            name="disconnect" visibility="public" ><ownedParameter xmi:id="63a4c6d2180a89.51313140" name="return" direction="return"><type xmi:idref="63a4c6d209e429.79234751"/></ownedParameter><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21e1424.81880690" annotatedElement="63a4c6d2180a19.94005564"><body>Disconnect from the POP3 server.</body></ownedComment></ownedOperation><ownedOperation xmi:id="63a4c6d2180ee6.94311171" 
            name="getResponse" visibility="protected" ><ownedParameter xmi:id="63a4c6d2180fc8.44820413" name="return" direction="return"><type xmi:idref="63a4c6d209e2b6.20155476"/></ownedParameter><ownedParameter xmi:id="63a4c6d2181004.78747726" name="$size" direction="in"><type xmi:idref="63a4c6d209e2f2.35908695"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21e1471.01436004" value="128" /></ownedParameter><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21e14a2.64394370" annotatedElement="63a4c6d2180ee6.94311171"><body>Get a response from the POP3 server.</body></ownedComment></ownedOperation><ownedOperation xmi:id="63a4c6d2181291.45998217" 
            name="sendString" visibility="protected" ><ownedParameter xmi:id="63a4c6d2181363.74850792" name="return" direction="return"><type xmi:idref="63a4c6d209e2f2.35908695"/></ownedParameter><ownedParameter xmi:id="63a4c6d2181398.74767650" name="$string" direction="in"><type xmi:idref="63a4c6d209e2b6.20155476"/></ownedParameter><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21e1510.93753623" annotatedElement="63a4c6d2181291.45998217"><body>Send raw data to the POP3 server.</body></ownedComment></ownedOperation><ownedOperation xmi:id="63a4c6d21816e1.91754927" 
            name="checkResponse" visibility="protected" ><ownedParameter xmi:id="63a4c6d21817c3.14856576" name="return" direction="return"><type xmi:idref="63a4c6d209e377.76986812"/></ownedParameter><ownedParameter xmi:id="63a4c6d21817e7.28108078" name="$string" direction="in"><type xmi:idref="63a4c6d209e2b6.20155476"/></ownedParameter><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21e1586.49435732" annotatedElement="63a4c6d21816e1.91754927"><body>Checks the POP3 server response.
Looks for for +OK or -ERR.</body></ownedComment></ownedOperation><ownedOperation xmi:id="63a4c6d2181ac1.44717271" 
            name="setError" visibility="protected" ><ownedParameter xmi:id="63a4c6d2181b76.87485692" name="return" direction="return"><type xmi:idref="63a4c6d209e429.79234751"/></ownedParameter><ownedParameter xmi:id="63a4c6d2181b93.30154066" name="$error" direction="in"><type xmi:idref="63a4c6d209e2b6.20155476"/></ownedParameter><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21e15f0.11777998" annotatedElement="63a4c6d2181ac1.44717271"><body>Add an error to the internal error store.
Also display debug output if it's enabled.</body></ownedComment></ownedOperation><ownedOperation xmi:id="63a4c6d2181e50.36774676" 
            name="getErrors" visibility="public" ><ownedParameter xmi:id="63a4c6d2181f32.06441375" name="return" direction="return"><type xmi:idref="63a4c6d209e232.56111258"/></ownedParameter><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21e1658.59948337" annotatedElement="63a4c6d2181e50.36774676"><body>Get an array of error messages, if any.</body></ownedComment></ownedOperation><ownedOperation xmi:id="63a4c6d2182173.61463696" 
            name="catchWarning" visibility="protected" ><ownedParameter xmi:id="63a4c6d2182289.45843637" name="return" direction="return"><type xmi:idref="63a4c6d209e429.79234751"/></ownedParameter><ownedParameter xmi:id="63a4c6d21822b5.04422301" name="$errno" direction="in"><type xmi:idref="63a4c6d209e2f2.35908695"/></ownedParameter><ownedParameter xmi:id="63a4c6d21822f1.98929854" name="$errstr" direction="in"><type xmi:idref="63a4c6d209e2b6.20155476"/></ownedParameter><ownedParameter xmi:id="63a4c6d2182332.70431532" name="$errfile" direction="in"><type xmi:idref="63a4c6d209e2b6.20155476"/></ownedParameter><ownedParameter xmi:id="63a4c6d2182375.44567304" name="$errline" direction="in"><type xmi:idref="63a4c6d209e2f2.35908695"/></ownedParameter><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21e1726.73855876" annotatedElement="63a4c6d2182173.61463696"><body>POP3 connection error handler.</body></ownedComment></ownedOperation><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21e1749.73223753" annotatedElement="63a4c6d217bdc0.65168279"><body>PHPMailer POP-Before-SMTP Authentication Class.
Specifically for PHPMailer to use for RFC1939 POP-before-SMTP authentication.
1) This class does not support APOP authentication.
2) Opening and closing lots of POP3 connections can be quite slow. If you need to send a batch of emails then just perform the authentication once at the start, and then loop through your mail sending script. Providing this process doesn't take longer than the verification period lasts on your POP3 server, you should be fine.
3) This is really ancient technology; you should only need to use it to talk to very old systems.
4) This POP3 class is deliberately lightweight and incomplete, implementing just enough to do authentication.
If you want a more complete class there are other POP3 classes for PHP available.</body></ownedComment></packagedElement><packagedElement xmi:type="uml:Class" name="SMTP" xmi:id="63a4c6d2186547.70864334" visibility="package"
            isAbstract="false"><ownedAttribute xmi:type="uml:Property" name="VERSION" xmi:id="63a4c6d21867e5.72534969" visibility="public"  isStatic="true" isReadOnly="true" ><type xmi:idref="63a4c6d209e2b6.20155476"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21e1808.78831818" value="&#039;6.7.1&#039;" /><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21e1835.48412646" annotatedElement="63a4c6d21867e5.72534969"><body>The PHPMailer SMTP version number.</body></ownedComment></ownedAttribute><ownedAttribute xmi:type="uml:Property" name="LE" xmi:id="63a4c6d21869c9.73225572" visibility="public"  isStatic="true" isReadOnly="true" ><type xmi:idref="63a4c6d209e2b6.20155476"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21e1865.68922912" value="&quot;\r\n&quot;" /><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21e1885.59119497" annotatedElement="63a4c6d21869c9.73225572"><body>SMTP line break constant.</body></ownedComment></ownedAttribute><ownedAttribute xmi:type="uml:Property" name="DEFAULT_PORT" xmi:id="63a4c6d2186ba3.25438292" visibility="public"  isStatic="true" isReadOnly="true" ><type xmi:idref="63a4c6d209e2f2.35908695"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21e18b0.05956516" value="25" /><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21e18d1.98547140" annotatedElement="63a4c6d2186ba3.25438292"><body>The SMTP port to use if one is not specified.</body></ownedComment></ownedAttribute><ownedAttribute xmi:type="uml:Property" name="MAX_LINE_LENGTH" xmi:id="63a4c6d2186ea5.14438024" visibility="public"  isStatic="true" isReadOnly="true" ><type xmi:idref="63a4c6d209e2f2.35908695"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21e1908.96089977" value="998" /><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21e1939.67896686" annotatedElement="63a4c6d2186ea5.14438024"><body>The maximum line length allowed by RFC 5321 section 4.5.3.1.6, *excluding* a trailing CRLF break.</body></ownedComment></ownedAttribute><ownedAttribute xmi:type="uml:Property" name="MAX_REPLY_LENGTH" xmi:id="63a4c6d2187202.38365709" visibility="public"  isStatic="true" isReadOnly="true" ><type xmi:idref="63a4c6d209e2f2.35908695"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21e1967.27260312" value="512" /><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21e1982.62860527" annotatedElement="63a4c6d2187202.38365709"><body>The maximum line length allowed for replies in RFC 5321 section 4.5.3.1.5, *including* a trailing CRLF line break.</body></ownedComment></ownedAttribute><ownedAttribute xmi:type="uml:Property" name="DEBUG_OFF" xmi:id="63a4c6d21873f5.14006760" visibility="public"  isStatic="true" isReadOnly="true" ><type xmi:idref="63a4c6d209e2f2.35908695"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21e19c8.03742688" value="0" /><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21e19e3.91533524" annotatedElement="63a4c6d21873f5.14006760"><body>Debug level for no output.</body></ownedComment></ownedAttribute><ownedAttribute xmi:type="uml:Property" name="DEBUG_CLIENT" xmi:id="63a4c6d21875d3.43063940" visibility="public"  isStatic="true" isReadOnly="true" ><type xmi:idref="63a4c6d209e2f2.35908695"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21e1a17.34490257" value="1" /><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21e1a35.61973228" annotatedElement="63a4c6d21875d3.43063940"><body>Debug level to show client -&gt; server messages.</body></ownedComment></ownedAttribute><ownedAttribute xmi:type="uml:Property" name="DEBUG_SERVER" xmi:id="63a4c6d21877e9.12784590" visibility="public"  isStatic="true" isReadOnly="true" ><type xmi:idref="63a4c6d209e2f2.35908695"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21e1a66.44518660" value="2" /><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21e1a95.57623418" annotatedElement="63a4c6d21877e9.12784590"><body>Debug level to show client -&gt; server and server -&gt; client messages.</body></ownedComment></ownedAttribute><ownedAttribute xmi:type="uml:Property" name="DEBUG_CONNECTION" xmi:id="63a4c6d2187a13.85093649" visibility="public"  isStatic="true" isReadOnly="true" ><type xmi:idref="63a4c6d209e2f2.35908695"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21e1ac1.25117762" value="3" /><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21e1ae8.22811668" annotatedElement="63a4c6d2187a13.85093649"><body>Debug level to show connection status, client -&gt; server and server -&gt; client messages.</body></ownedComment></ownedAttribute><ownedAttribute xmi:type="uml:Property" name="DEBUG_LOWLEVEL" xmi:id="63a4c6d2187bd0.50904404" visibility="public"  isStatic="true" isReadOnly="true" ><type xmi:idref="63a4c6d209e2f2.35908695"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21e1b14.76172255" value="4" /><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21e1b33.90274178" annotatedElement="63a4c6d2187bd0.50904404"><body>Debug level to show all messages.</body></ownedComment></ownedAttribute><ownedAttribute xmi:type="uml:Property" name="$do_debug" xmi:id="63a4c6d2188068.78030891" visibility="public" ><type xmi:idref="63a4c6d209e2f2.35908695"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21e1b64.13060286" value="selfDEBUG_OFF" /><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21e1b85.43516225" annotatedElement="63a4c6d2188068.78030891"><body>Debug output level.
Options:
* self::DEBUG_OFF (`0`) No debug output, default * self::DEBUG_CLIENT (`1`) Client commands * self::DEBUG_SERVER (`2`) Client commands and server responses * self::DEBUG_CONNECTION (`3`) As DEBUG_SERVER plus connection status * self::DEBUG_LOWLEVEL (`4`) Low-level data output, all messages.</body></ownedComment></ownedAttribute><ownedAttribute xmi:type="uml:Property" name="$Debugoutput" xmi:id="63a4c6d2188888.21202691" visibility="public" ><type xmi:idref="63a4c6d209e2b6.20155476"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21e1be0.86058730" value="&#039;echo&#039;" /><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21e1c05.42082013" annotatedElement="63a4c6d2188888.21202691"><body>How to handle debug output.
Options:
* `echo` Output plain-text as-is, appropriate for CLI * `html` Output escaped, line breaks converted to `&lt;br&gt;`, appropriate for browser output * `error_log` Output to error log as configured in php.ini Alternatively, you can provide a callable expecting two params: a message string and the debug level:

```php $smtp-&gt;Debugoutput = function($str, $level) {echo &quot;debug level $level; message: $str&quot;;}; ``` 
Alternatively, you can pass in an instance of a PSR-3 compatible logger, though only `debug` level output is used:

```php $mail-&gt;Debugoutput = new myPsr3Logger; ```</body></ownedComment></ownedAttribute><ownedAttribute xmi:type="uml:Property" name="$do_verp" xmi:id="63a4c6d2188c15.50817883" visibility="public" ><type xmi:idref="63a4c6d209e377.76986812"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21e1c80.80305374" value="false" /><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21e1ca7.10589774" annotatedElement="63a4c6d2188c15.50817883"><body>Whether to use VERP.</body></ownedComment></ownedAttribute><ownedAttribute xmi:type="uml:Property" name="$Timeout" xmi:id="63a4c6d2189058.34714428" visibility="public" ><type xmi:idref="63a4c6d209e2f2.35908695"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21e1cd5.71248914" value="300" /><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21e1cf7.87414799" annotatedElement="63a4c6d2189058.34714428"><body>The timeout value for connection, in seconds.
Default of 5 minutes (300sec) is from RFC2821 section 4.5.3.2.
This needs to be quite high to function correctly with hosts using greetdelay as an anti-spam measure.</body></ownedComment></ownedAttribute><ownedAttribute xmi:type="uml:Property" name="$Timelimit" xmi:id="63a4c6d2189326.98854744" visibility="public" ><type xmi:idref="63a4c6d209e2f2.35908695"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21e1d36.70063900" value="300" /><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21e1d67.24923729" annotatedElement="63a4c6d2189326.98854744"><body>How long to wait for commands to complete, in seconds.
Default of 5 minutes (300sec) is from RFC2821 section 4.5.3.2.</body></ownedComment></ownedAttribute><ownedAttribute xmi:type="uml:Property" name="$smtp_transaction_id_patterns" xmi:id="63a4c6d2189727.20463087" visibility="protected" ><type xmi:idref="63a4c6d209e2b6.20155476"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21e1d96.65163320" value="&#039;exim&#039;=&gt;&#039;/[\d]{3} OK id=(.*)/&#039;" /><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21e1dc5.83068904" annotatedElement="63a4c6d2189727.20463087"><body>Patterns to extract an SMTP transaction id from reply to a DATA command.
The first capture group in each regex will be used as the ID.
MS ESMTP returns the message ID, which may not be correct for internal tracking.</body></ownedComment></ownedAttribute><ownedAttribute xmi:type="uml:Property" name="$last_smtp_transaction_id" xmi:id="63a4c6d2189f20.65251963" visibility="protected" ><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21e1e24.19148597" annotatedElement="63a4c6d2189f20.65251963"><body>The last transaction ID issued in response to a DATA command, if one was detected.</body></ownedComment></ownedAttribute><ownedAttribute xmi:type="uml:Property" name="$smtp_conn" xmi:id="63a4c6d218a145.17549996" visibility="protected" ><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21e1e79.30801344" annotatedElement="63a4c6d218a145.17549996"><body>The socket for the server connection.</body></ownedComment></ownedAttribute><ownedAttribute xmi:type="uml:Property" name="$error" xmi:id="63a4c6d218a365.41251376" visibility="protected" ><type xmi:idref="63a4c6d209e2b6.20155476"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21e1e99.27681283" value="&#039;error&#039;=&gt;&#039;&#039;" /><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21e1ec2.74257421" annotatedElement="63a4c6d218a365.41251376"><body>Error information, if any, for the last SMTP command.</body></ownedComment></ownedAttribute><ownedAttribute xmi:type="uml:Property" name="$helo_rply" xmi:id="63a4c6d218a702.88222285" visibility="protected" ><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21e1f02.08121967" annotatedElement="63a4c6d218a702.88222285"><body>The reply the server sent to us for HELO.
If null, no HELO string has yet been received.</body></ownedComment></ownedAttribute><ownedAttribute xmi:type="uml:Property" name="$server_caps" xmi:id="63a4c6d218abf9.00210260" visibility="protected" ><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21e1f57.88344338" annotatedElement="63a4c6d218abf9.00210260"><body>The set of SMTP extensions sent in reply to EHLO command.
Indexes of the array are extension names.
Value at index 'HELO' or 'EHLO' (according to command that was sent) represents the server name. In case of HELO it is the only element of the array.
Other values can be boolean TRUE or an array containing extension options.
If null, no HELO/EHLO string has yet been received.</body></ownedComment></ownedAttribute><ownedAttribute xmi:type="uml:Property" name="$last_reply" xmi:id="63a4c6d218ae20.75496647" visibility="protected" ><type xmi:idref="63a4c6d209e2b6.20155476"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21e1fb7.17448125" value="&#039;&#039;" /><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21e1fd3.31233011" annotatedElement="63a4c6d218ae20.75496647"><body>The most recent reply received from the server.</body></ownedComment></ownedAttribute><ownedOperation xmi:id="63a4c6d218b171.76703800" 
            name="edebug" visibility="protected" ><ownedParameter xmi:id="63a4c6d218b298.93671455" name="return" direction="return"><type xmi:idref="63a4c6d209e429.79234751"/></ownedParameter><ownedParameter xmi:id="63a4c6d218b2c7.45709058" name="$str" direction="in"><type xmi:idref="63a4c6d209e2b6.20155476"/></ownedParameter><ownedParameter xmi:id="63a4c6d218b321.34063647" name="$level" direction="in"><type xmi:idref="63a4c6d209e2f2.35908695"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21e2041.45934344" value="0" /></ownedParameter><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21e2075.69111343" annotatedElement="63a4c6d218b171.76703800"><body>Output debugging info via a user-selected method.</body></ownedComment></ownedOperation><ownedOperation xmi:id="63a4c6d218bc32.70744181" 
            name="connect" visibility="public" ><ownedParameter xmi:id="63a4c6d218bd75.39683457" name="return" direction="return"><type xmi:idref="63a4c6d209e377.76986812"/></ownedParameter><ownedParameter xmi:id="63a4c6d218bda8.74829042" name="$host" direction="in"><type xmi:idref="63a4c6d209e2b6.20155476"/></ownedParameter><ownedParameter xmi:id="63a4c6d218be06.46307634" name="$port" direction="in"><type xmi:idref="63a4c6d209e2f2.35908695"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21e20f3.22329271" value="null" /></ownedParameter><ownedParameter xmi:id="63a4c6d218be62.89813543" name="$timeout" direction="in"><type xmi:idref="63a4c6d209e2f2.35908695"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21e2110.35775613" value="30" /></ownedParameter><ownedParameter xmi:id="63a4c6d218beb2.65787902" name="$options" direction="in"><type xmi:idref="63a4c6d209e232.56111258"/></ownedParameter><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21e2167.50974843" annotatedElement="63a4c6d218bc32.70744181"><body>Connect to an SMTP server.</body></ownedComment></ownedOperation><ownedOperation xmi:id="63a4c6d218c8c3.57007523" 
            name="getSMTPConnection" visibility="protected" ><ownedParameter xmi:id="63a4c6d218ca07.85542851" name="return" direction="return"></ownedParameter><ownedParameter xmi:id="63a4c6d218ca26.72394200" name="$host" direction="in"><type xmi:idref="63a4c6d209e2b6.20155476"/></ownedParameter><ownedParameter xmi:id="63a4c6d218ca80.52811604" name="$port" direction="in"><type xmi:idref="63a4c6d209e2f2.35908695"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21e21c6.11135885" value="null" /></ownedParameter><ownedParameter xmi:id="63a4c6d218cae9.28433587" name="$timeout" direction="in"><type xmi:idref="63a4c6d209e2f2.35908695"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21e21f5.70913891" value="30" /></ownedParameter><ownedParameter xmi:id="63a4c6d218cb49.91258221" name="$options" direction="in"><type xmi:idref="63a4c6d209e232.56111258"/></ownedParameter><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21e2230.82560142" annotatedElement="63a4c6d218c8c3.57007523"><body>Create connection to the SMTP server.</body></ownedComment></ownedOperation><ownedOperation xmi:id="63a4c6d218d426.38359044" 
            name="startTLS" visibility="public" ><ownedParameter xmi:id="63a4c6d218d4d7.02873270" name="return" direction="return"><type xmi:idref="63a4c6d209e377.76986812"/></ownedParameter><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21e2295.40430086" annotatedElement="63a4c6d218d426.38359044"><body>Initiate a TLS (encrypted) session.</body></ownedComment></ownedOperation><ownedOperation xmi:id="63a4c6d218dbf2.02755095" 
            name="authenticate" visibility="public" ><ownedParameter xmi:id="63a4c6d218dd70.06577967" name="return" direction="return"><type xmi:idref="63a4c6d209e377.76986812"/></ownedParameter><ownedParameter xmi:id="63a4c6d218dda4.45717688" name="$username" direction="in"><type xmi:idref="63a4c6d209e2b6.20155476"/></ownedParameter><ownedParameter xmi:id="63a4c6d218dde7.00737274" name="$password" direction="in"><type xmi:idref="63a4c6d209e2b6.20155476"/></ownedParameter><ownedParameter xmi:id="63a4c6d218de49.02729225" name="$authtype" direction="in"><type xmi:idref="63a4c6d209e2b6.20155476"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21e2313.21664061" value="null" /></ownedParameter><ownedParameter xmi:id="63a4c6d218dea3.70149141" name="$OAuth" direction="in"><type xmi:idref="63a4c6d2114089.99950322"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21e2334.59147760" value="null" /></ownedParameter><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21e2369.76314658" annotatedElement="63a4c6d218dbf2.02755095"><body>Perform SMTP authentication.
Must be run after hello().</body></ownedComment></ownedOperation><ownedOperation xmi:id="63a4c6d218f217.68576108" 
            name="hmac" visibility="protected" ><ownedParameter xmi:id="63a4c6d218f364.23439948" name="return" direction="return"><type xmi:idref="63a4c6d209e2b6.20155476"/></ownedParameter><ownedParameter xmi:id="63a4c6d218f391.90810087" name="$data" direction="in"><type xmi:idref="63a4c6d209e2b6.20155476"/></ownedParameter><ownedParameter xmi:id="63a4c6d218f3e0.21148430" name="$key" direction="in"><type xmi:idref="63a4c6d209e2b6.20155476"/></ownedParameter><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21e23f1.11345420" annotatedElement="63a4c6d218f217.68576108"><body>Calculate an MD5 HMAC hash.
Works like hash_hmac('md5', $data, $key) in case that function is not available.</body></ownedComment></ownedOperation><ownedOperation xmi:id="63a4c6d218f968.28311467" 
            name="connected" visibility="public" ><ownedParameter xmi:id="63a4c6d218fa17.97958759" name="return" direction="return"><type xmi:idref="63a4c6d209e377.76986812"/></ownedParameter><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21e2453.28270486" annotatedElement="63a4c6d218f968.28311467"><body>Check connection state.</body></ownedComment></ownedOperation><ownedOperation xmi:id="63a4c6d218fdd6.43594334" 
            name="close" visibility="public" ><ownedParameter xmi:id="63a4c6d218fe75.12181757" name="return" direction="return"><type xmi:idref="63a4c6d209e429.79234751"/></ownedParameter><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21e24a5.51350637" annotatedElement="63a4c6d218fdd6.43594334"><body>Close the socket and clean up the state of the class.
Don't use this function without first trying to use QUIT.</body></ownedComment></ownedOperation><ownedOperation xmi:id="63a4c6d21904c3.91058481" 
            name="data" visibility="public" ><ownedParameter xmi:id="63a4c6d21905f8.86692780" name="return" direction="return"><type xmi:idref="63a4c6d209e377.76986812"/></ownedParameter><ownedParameter xmi:id="63a4c6d2190626.84885569" name="$msg_data" direction="in"><type xmi:idref="63a4c6d209e2b6.20155476"/></ownedParameter><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21e2510.51128990" annotatedElement="63a4c6d21904c3.91058481"><body>Send an SMTP DATA command.
Issues a data command and sends the msg_data to the server, finalizing the mail transaction. $msg_data is the message that is to be send with the headers. Each header needs to be on a single line followed by a &lt;CRLF&gt; with the message headers and the message body being separated by an additional &lt;CRLF&gt;.
Implements RFC 821: DATA &lt;CRLF&gt;.</body></ownedComment></ownedOperation><ownedOperation xmi:id="63a4c6d2191475.49836495" 
            name="hello" visibility="public" ><ownedParameter xmi:id="63a4c6d2191573.94077610" name="return" direction="return"><type xmi:idref="63a4c6d209e377.76986812"/></ownedParameter><ownedParameter xmi:id="63a4c6d21915b5.83981149" name="$host" direction="in"><type xmi:idref="63a4c6d209e2b6.20155476"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21e2599.94961978" value="&#039;&#039;" /></ownedParameter><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21e25c7.64815917" annotatedElement="63a4c6d2191475.49836495"><body>Send an SMTP HELO or EHLO command.
Used to identify the sending server to the receiving server.
This makes sure that client and server are in a known state.
Implements RFC 821: HELO &lt;SP&gt; &lt;domain&gt; &lt;CRLF&gt; and RFC 2821 EHLO.</body></ownedComment></ownedOperation><ownedOperation xmi:id="63a4c6d2191a78.73455010" 
            name="sendHello" visibility="protected" ><ownedParameter xmi:id="63a4c6d2191bb3.42188686" name="return" direction="return"><type xmi:idref="63a4c6d209e377.76986812"/></ownedParameter><ownedParameter xmi:id="63a4c6d2191be4.30731820" name="$hello" direction="in"><type xmi:idref="63a4c6d209e2b6.20155476"/></ownedParameter><ownedParameter xmi:id="63a4c6d2191c23.25634489" name="$host" direction="in"><type xmi:idref="63a4c6d209e2b6.20155476"/></ownedParameter><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21e2674.97447636" annotatedElement="63a4c6d2191a78.73455010"><body>Send an SMTP HELO or EHLO command.
Low-level implementation used by hello().</body></ownedComment></ownedOperation><ownedOperation xmi:id="63a4c6d2192044.49223738" 
            name="parseHelloFields" visibility="protected" ><ownedParameter xmi:id="63a4c6d2192104.30838378" name="return" direction="return"><type xmi:idref="63a4c6d209e429.79234751"/></ownedParameter><ownedParameter xmi:id="63a4c6d2192124.14239003" name="$type" direction="in"><type xmi:idref="63a4c6d209e2b6.20155476"/></ownedParameter><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21e26e5.17451954" annotatedElement="63a4c6d2192044.49223738"><body>Parse a reply to HELO/EHLO command to discover server extensions.
In case of HELO, the only parameter that can be discovered is a server name.</body></ownedComment></ownedOperation><ownedOperation xmi:id="63a4c6d2192af0.25390768" 
            name="mail" visibility="public" ><ownedParameter xmi:id="63a4c6d2192c07.73990179" name="return" direction="return"><type xmi:idref="63a4c6d209e377.76986812"/></ownedParameter><ownedParameter xmi:id="63a4c6d2192c27.39428867" name="$from" direction="in"><type xmi:idref="63a4c6d209e2b6.20155476"/></ownedParameter><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21e2768.61691233" annotatedElement="63a4c6d2192af0.25390768"><body>Send an SMTP MAIL command.
Starts a mail transaction from the email address specified in $from. Returns true if successful or false otherwise. If True the mail transaction is started and then one or more recipient commands may be called followed by a data command.
Implements RFC 821: MAIL &lt;SP&gt; FROM:&lt;reverse-path&gt; &lt;CRLF&gt;.</body></ownedComment></ownedOperation><ownedOperation xmi:id="63a4c6d2193062.13990899" 
            name="quit" visibility="public" ><ownedParameter xmi:id="63a4c6d21931f0.91535792" name="return" direction="return"><type xmi:idref="63a4c6d209e377.76986812"/></ownedParameter><ownedParameter xmi:id="63a4c6d2193230.78238375" name="$close_on_error" direction="in"><type xmi:idref="63a4c6d209e377.76986812"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21e27e7.70052617" value="true" /></ownedParameter><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21e2800.21038266" annotatedElement="63a4c6d2193062.13990899"><body>Send an SMTP QUIT command.
Closes the socket if there is no error or the $close_on_error argument is true.
Implements from RFC 821: QUIT &lt;CRLF&gt;.</body></ownedComment></ownedOperation><ownedOperation xmi:id="63a4c6d21938b7.45862740" 
            name="recipient" visibility="public" ><ownedParameter xmi:id="63a4c6d21939d2.61237404" name="return" direction="return"><type xmi:idref="63a4c6d209e377.76986812"/></ownedParameter><ownedParameter xmi:id="63a4c6d2193a05.26361975" name="$address" direction="in"><type xmi:idref="63a4c6d209e2b6.20155476"/></ownedParameter><ownedParameter xmi:id="63a4c6d2193a63.41149556" name="$dsn" direction="in"><type xmi:idref="63a4c6d209e2b6.20155476"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21e2880.12221109" value="&#039;&#039;" /></ownedParameter><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21e28b3.20459302" annotatedElement="63a4c6d21938b7.45862740"><body>Send an SMTP RCPT command.
Sets the TO argument to $toaddr.
Returns true if the recipient was accepted false if it was rejected.
Implements from RFC 821: RCPT &lt;SP&gt; TO:&lt;forward-path&gt; &lt;CRLF&gt;.</body></ownedComment></ownedOperation><ownedOperation xmi:id="63a4c6d21940b5.13092379" 
            name="reset" visibility="public" ><ownedParameter xmi:id="63a4c6d2194177.53192886" name="return" direction="return"><type xmi:idref="63a4c6d209e377.76986812"/></ownedParameter><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21e2912.24302579" annotatedElement="63a4c6d21940b5.13092379"><body>Send an SMTP RSET command.
Abort any transaction that is currently in progress.
Implements RFC 821: RSET &lt;CRLF&gt;.</body></ownedComment></ownedOperation><ownedOperation xmi:id="63a4c6d2194592.24747875" 
            name="sendCommand" visibility="protected" ><ownedParameter xmi:id="63a4c6d21946c6.57121179" name="return" direction="return"><type xmi:idref="63a4c6d209e377.76986812"/></ownedParameter><ownedParameter xmi:id="63a4c6d21946f0.45025719" name="$command" direction="in"><type xmi:idref="63a4c6d209e2b6.20155476"/></ownedParameter><ownedParameter xmi:id="63a4c6d2194733.92711818" name="$commandstring" direction="in"><type xmi:idref="63a4c6d209e2b6.20155476"/></ownedParameter><ownedParameter xmi:id="63a4c6d2194775.47456656" name="$expect" direction="in"></ownedParameter><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21e29d0.51450820" annotatedElement="63a4c6d2194592.24747875"><body>Send a command to an SMTP server and check its return code.</body></ownedComment></ownedOperation><ownedOperation xmi:id="63a4c6d2195668.43383933" 
            name="sendAndMail" visibility="public" ><ownedParameter xmi:id="63a4c6d21957a6.49608201" name="return" direction="return"><type xmi:idref="63a4c6d209e377.76986812"/></ownedParameter><ownedParameter xmi:id="63a4c6d21957d7.44121372" name="$from" direction="in"><type xmi:idref="63a4c6d209e2b6.20155476"/></ownedParameter><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21e2a44.82384746" annotatedElement="63a4c6d2195668.43383933"><body>Send an SMTP SAML command.
Starts a mail transaction from the email address specified in $from.
Returns true if successful or false otherwise. If True the mail transaction is started and then one or more recipient commands may be called followed by a data command. This command will send the message to the users terminal if they are logged in and send them an email.
Implements RFC 821: SAML &lt;SP&gt; FROM:&lt;reverse-path&gt; &lt;CRLF&gt;.</body></ownedComment></ownedOperation><ownedOperation xmi:id="63a4c6d2195a21.50405205" 
            name="verify" visibility="public" ><ownedParameter xmi:id="63a4c6d2195af6.85452246" name="return" direction="return"><type xmi:idref="63a4c6d209e377.76986812"/></ownedParameter><ownedParameter xmi:id="63a4c6d2195b22.87820159" name="$name" direction="in"><type xmi:idref="63a4c6d209e2b6.20155476"/></ownedParameter><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21e2af1.56035769" annotatedElement="63a4c6d2195a21.50405205"><body>Send an SMTP VRFY command.</body></ownedComment></ownedOperation><ownedOperation xmi:id="63a4c6d2195d92.58393317" 
            name="noop" visibility="public" ><ownedParameter xmi:id="63a4c6d2195e49.91034737" name="return" direction="return"><type xmi:idref="63a4c6d209e377.76986812"/></ownedParameter><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21e2b48.63063548" annotatedElement="63a4c6d2195d92.58393317"><body>Send an SMTP NOOP command.
Used to keep keep-alives alive, doesn't actually do anything.</body></ownedComment></ownedOperation><ownedOperation xmi:id="63a4c6d2196208.27561942" 
            name="turn" visibility="public" ><ownedParameter xmi:id="63a4c6d21962d8.28213995" name="return" direction="return"><type xmi:idref="63a4c6d209e377.76986812"/></ownedParameter><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21e2b97.05309068" annotatedElement="63a4c6d2196208.27561942"><body>Send an SMTP TURN command.
This is an optional command for SMTP that this class does not support.
This method is here to make the RFC821 Definition complete for this class and _may_ be implemented in future.
Implements from RFC 821: TURN &lt;CRLF&gt;.</body></ownedComment></ownedOperation><ownedOperation xmi:id="63a4c6d21966b6.65626699" 
            name="client_send" visibility="public" ><ownedParameter xmi:id="63a4c6d21967f6.85511920" name="return" direction="return"></ownedParameter><ownedParameter xmi:id="63a4c6d2196817.72336707" name="$data" direction="in"><type xmi:idref="63a4c6d209e2b6.20155476"/></ownedParameter><ownedParameter xmi:id="63a4c6d2196876.67845369" name="$command" direction="in"><type xmi:idref="63a4c6d209e2b6.20155476"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21e2c25.02137626" value="&#039;&#039;" /></ownedParameter><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21e2c59.77079830" annotatedElement="63a4c6d21966b6.65626699"><body>Send raw data to the server.</body></ownedComment></ownedOperation><ownedOperation xmi:id="63a4c6d2196c46.45413827" 
            name="getError" visibility="public" ><ownedParameter xmi:id="63a4c6d2196cf6.69403524" name="return" direction="return"><type xmi:idref="63a4c6d209e232.56111258"/></ownedParameter><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21e2ca1.17612419" annotatedElement="63a4c6d2196c46.45413827"><body>Get the latest error.</body></ownedComment></ownedOperation><ownedOperation xmi:id="63a4c6d2196e84.54774857" 
            name="getServerExtList" visibility="public" ><ownedParameter xmi:id="63a4c6d2196f31.01519552" name="return" direction="return"></ownedParameter><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21e2cf5.42825139" annotatedElement="63a4c6d2196e84.54774857"><body>Get SMTP extensions available on the server.</body></ownedComment></ownedOperation><ownedOperation xmi:id="63a4c6d21976f3.94603495" 
            name="getServerExt" visibility="public" ><ownedParameter xmi:id="63a4c6d2197862.50839153" name="return" direction="return"></ownedParameter><ownedParameter xmi:id="63a4c6d2197894.61402386" name="$name" direction="in"><type xmi:idref="63a4c6d209e2b6.20155476"/></ownedParameter><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21e2d68.97108165" annotatedElement="63a4c6d21976f3.94603495"><body>Get metadata about the SMTP server from its HELO/EHLO response.
The method works in three ways, dependent on argument value and current state:
1. HELO/EHLO has not been sent - returns null and populates $this-&gt;error.
2. HELO has been sent - $name == 'HELO': returns server name $name == 'EHLO': returns boolean false $name == any other string: returns null and populates $this-&gt;error 3. EHLO has been sent - $name == 'HELO'|'EHLO': returns the server name $name == any other string: if extension $name exists, returns True or its options (e.g. AUTH mechanisms supported). Otherwise returns False.</body></ownedComment></ownedOperation><ownedOperation xmi:id="63a4c6d2197c91.02067296" 
            name="getLastReply" visibility="public" ><ownedParameter xmi:id="63a4c6d2197d45.28392661" name="return" direction="return"><type xmi:idref="63a4c6d209e2b6.20155476"/></ownedParameter><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21e2e04.73603678" annotatedElement="63a4c6d2197c91.02067296"><body>Get the last reply from the server.</body></ownedComment></ownedOperation><ownedOperation xmi:id="63a4c6d21980b5.47551192" 
            name="get_lines" visibility="protected" ><ownedParameter xmi:id="63a4c6d2198182.69573172" name="return" direction="return"><type xmi:idref="63a4c6d209e2b6.20155476"/></ownedParameter><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21e2e52.44070404" annotatedElement="63a4c6d21980b5.47551192"><body>Read the SMTP server's response.
Either before eof or socket timeout occurs on the operation.
With SMTP we can tell if we have more lines to read if the 4th character is '-' symbol. If it is a space then we don't need to read anything else.</body></ownedComment></ownedOperation><ownedOperation xmi:id="63a4c6d2198e06.75249610" 
            name="setVerp" visibility="public" ><ownedParameter xmi:id="63a4c6d2198ea4.07273824" name="return" direction="return"><type xmi:idref="63a4c6d209e429.79234751"/></ownedParameter><ownedParameter xmi:id="63a4c6d2198f05.78250721" name="$enabled" direction="in"><type xmi:idref="63a4c6d209e377.76986812"/><defaultValue xmi:type="uml:LiteralString" xmi:id="63a4c6d21e2ec6.64879292" value="false" /></ownedParameter><ownedComment xmi:type="uml:Comment"
                xmi:id="63a4c6d21e2ee0.38702647" annotatedElement="63a4c6d2198e06.75249610"><body>Enable or disable VERP address generation.</body></ownedComment></ownedOperation><ownedOperation xmi:id="63a4c6d2199097.16868913" 
